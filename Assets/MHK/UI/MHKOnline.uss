/* Online pages (imported by MHKTheme.uss): the shared info chips and segmented chips, the Online page (mod set cards of
 * the public categories, private room panel), the room settings (mod toggle cards, rule rows) and the lobby (player cards,
 * phase banner, side panel). Elements code shows only in some states are hidden here; preview-* classes on a page root and
 * sample-* classes on template instances show those states in UI Builder. */

/* Info chips (shared by every screen: InfoChips.Add in code): an icon and 1-3 words summarizing a setting or state, the
 * explanation in the tooltip. .info-chips is the row container. Variants: .on (accent: the setting is on and matters),
 * .off (dimmed), .good, .bad; .big for headers; .dark on dark plates (HUD, loading screen). */
.info-chips { flex-direction: row; flex-wrap: wrap; align-items: center; }
.info-chip { flex-direction: row; align-items: center; flex-shrink: 0; height: 30px; padding: 0 10px 0 7px; margin: 2px 6px 2px 0; border-radius: 15px; background-color: rgba(23, 25, 29, 0.08); }
.info-chip.icon-only { padding: 0 6px; }
.icon.info-chip-icon { width: 20px; height: 20px; margin-right: 4px; -unity-background-image-tint-color: var(--mhk-gray-700); }
.info-chip.icon-only .info-chip-icon { margin-right: 0; }
.info-chip-label { -unity-font-definition: var(--font-bold); font-size: 15px; color: var(--mhk-gray-800); padding: 0; margin: 0; white-space: nowrap; }
.info-chip.on { background-color: var(--mhk-accent-soft); }
.info-chip.on .info-chip-icon { -unity-background-image-tint-color: var(--mhk-accent-deep); }
.info-chip.off { opacity: 0.45; }
.info-chip.good { background-color: rgba(24, 121, 78, 0.16); }
.info-chip.good .info-chip-icon { -unity-background-image-tint-color: var(--mhk-good-ink); }
.info-chip.good .info-chip-label { color: var(--mhk-good-ink); }
.info-chip.bad { background-color: rgba(194, 54, 44, 0.14); }
.info-chip.bad .info-chip-icon { -unity-background-image-tint-color: var(--mhk-bad-ink); }
.info-chip.bad .info-chip-label { color: var(--mhk-bad-ink); }
.info-chip.big { height: 38px; border-radius: 19px; padding: 0 14px 0 9px; }
.info-chip.big .info-chip-icon { width: 26px; height: 26px; margin-right: 6px; }
.info-chip.big .info-chip-label { font-size: 19px; }
.info-chip.dark { background-color: rgba(255, 255, 255, 0.14); }
.info-chip.dark .info-chip-icon { -unity-background-image-tint-color: var(--mhk-white); }
.info-chip.dark .info-chip-label { color: var(--mhk-white); }

/* Icons of the online pages (Material Symbols Rounded, rendered like the theme's). */
.i-shield { background-image: url("Icons/shield.png"); }
.i-remove_moderator { background-image: url("Icons/remove_moderator.png"); }
.i-redeem { background-image: url("Icons/redeem.png"); }
.i-smart_toy { background-image: url("Icons/smart_toy.png"); }
.i-group { background-image: url("Icons/group.png"); }
.i-crown { background-image: url("Icons/crown.png"); }
.i-hourglass_top { background-image: url("Icons/hourglass_top.png"); }
.i-content_copy { background-image: url("Icons/content_copy.png"); }
.i-link { background-image: url("Icons/link.png"); }
.i-signal_cellular_alt { background-image: url("Icons/signal_cellular_alt.png"); }
.i-computer { background-image: url("Icons/computer.png"); }
.i-phone_android { background-image: url("Icons/phone_android.png"); }
.i-phone_iphone { background-image: url("Icons/phone_iphone.png"); }
.i-signal_cellular_alt_2_bar { background-image: url("Icons/signal_cellular_alt_2_bar.png"); }
.i-signal_cellular_alt_1_bar { background-image: url("Icons/signal_cellular_alt_1_bar.png"); }
.i-how_to_vote { background-image: url("Icons/how_to_vote.png"); }
.i-pin { background-image: url("Icons/pin.png"); }
.i-public { background-image: url("Icons/public.png"); }
.i-lock { background-image: url("Icons/lock.png"); }
.i-repeat { background-image: url("Icons/repeat.png"); }
.i-military_tech { background-image: url("Icons/military_tech.png"); }
.i-stadium { background-image: url("Icons/stadium.png"); }
.i-edit { background-image: url("Icons/edit.png"); }
.i-remove { background-image: url("Icons/remove.png"); }

/* Segmented chips (OnlineUi.Segmented): a .tabs row of .chip buttons with an icon and a label. */
.chip.seg-chip { flex-direction: row; align-items: center; padding: 0 16px 2px 12px; }
.chip.seg-chip .icon { width: 22px; height: 22px; margin-right: 6px; -unity-background-image-tint-color: var(--mhk-gray-600); }
.chip.seg-chip:hover .icon, .chip.seg-chip:focus .icon { -unity-background-image-tint-color: var(--mhk-white); }
.chip.seg-chip.selected .icon { -unity-background-image-tint-color: var(--mhk-gray-900); }
.seg-chip-label { padding: 0; margin: 0; -unity-font-definition: var(--font-bold); font-size: 18px; color: var(--mhk-gray-600); }
.chip.seg-chip:hover .seg-chip-label, .chip.seg-chip:focus .seg-chip-label { color: var(--mhk-white); }
.chip.seg-chip.selected .seg-chip-label, .chip.seg-chip.selected:hover .seg-chip-label, .chip.seg-chip.selected:focus .seg-chip-label { color: var(--mhk-gray-900); }
.chip.seg-chip.selected:hover .icon, .chip.seg-chip.selected:focus .icon { -unity-background-image-tint-color: var(--mhk-gray-900); }

/* Status line of the online pages (errors red, progress and success .good). */
.onl-status { flex-direction: row; align-items: center; flex-shrink: 0; margin-top: 8px; }
.onl-status .icon { width: 24px; height: 24px; margin-right: 6px; flex-shrink: 0; -unity-background-image-tint-color: var(--mhk-bad-ink); }
.onl-status-label { font-size: 16px; color: var(--mhk-bad-ink); white-space: normal; flex-shrink: 1; padding: 0; margin: 0; }
.onl-status.good .icon { -unity-background-image-tint-color: var(--mhk-good-ink); }
.onl-status.good .onl-status-label { color: var(--mhk-good-ink); }

/* Pack logos everywhere (Online rows, room settings pack cards): fixed boxes, logo scaled to fit, equal gaps. */
.pack-logos { flex-direction: row; align-items: center; flex-shrink: 0; }
.pack-logo { width: 72px; height: 32px; margin: 0 4px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; }
.pack-logo-missing { background-image: url("Icons/extension.png"); -unity-background-image-tint-color: var(--mhk-gray-400); }

/* Online page: one table of every public lobby (columns shared by onl-head and Templates/OnlineInstanceRow.uxml), the
   private room panel beside it. Spacing scale 8 / 16 / 24. */
.onl-browser { flex-grow: 1; flex-direction: row; align-items: flex-start; min-height: 0; }
.panel.onl-public { flex-grow: 1; flex-shrink: 1; flex-basis: 0; max-height: 100%; padding: 16px 16px 16px 16px; }
.onl-head { flex-direction: row; align-items: center; flex-shrink: 0; height: 32px; padding: 0 18px; margin-bottom: 8px; }
.onl-head .onl-head-label { font-size: 15px; -unity-font-definition: var(--font-bold); color: var(--mhk-gray-500); padding: 0; margin: 0; }
.onl-head .icon { width: 22px; height: 22px; -unity-background-image-tint-color: var(--mhk-gray-500); }
.onl-list-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.onl-list { flex-direction: column; }
.onl-row { flex-direction: row; align-items: center; height: 52px; min-height: 52px; flex-shrink: 0; margin: 0 0 8px 0; padding: 0 16px; border-radius: 16px; border-width: 2px; border-color: rgba(0, 0, 0, 0); background-color: rgba(255, 255, 255, 0.72); }
.onl-row:hover, .onl-row:focus { background-color: var(--mhk-white); border-color: var(--mhk-accent); }
.onl-row:disabled { opacity: 0.5; }
.onl-row Label { padding: 0; margin: 0; }
.icon.onl-col-mode { width: 32px; height: 32px; margin-right: 8px; flex-shrink: 0; -unity-background-image-tint-color: var(--mhk-gray-700); }
.onl-col-inst { width: 48px; flex-shrink: 0; -unity-font-definition: var(--font-display); font-size: 22px; color: var(--mhk-gray-500); -unity-text-align: middle-left; }
.onl-col-set { flex-grow: 1; flex-shrink: 1; min-width: 0; flex-direction: row; align-items: center; overflow: hidden; }
.onl-row-set { width: 168px; -unity-font-definition: var(--font-display); font-size: 24px; color: var(--mhk-gray-900); flex-shrink: 0; -unity-text-align: middle-left; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.onl-col-ac { width: 64px; flex-shrink: 0; align-items: center; }
.icon.onl-row-ac { width: 28px; height: 28px; -unity-background-image-tint-color: var(--mhk-good-ink); }
.icon.onl-row-ac.off { -unity-background-image-tint-color: var(--mhk-gray-400); }
.onl-col-engine { width: 88px; flex-shrink: 0; -unity-font-definition: var(--font-bold); font-size: 18px; color: var(--mhk-gray-700); -unity-text-align: middle-center; }
.onl-col-players { width: 168px; flex-shrink: 0; flex-direction: row; align-items: center; padding: 0 8px; }
.onl-row-players { width: 56px; flex-shrink: 0; -unity-font-definition: var(--font-bold); font-size: 18px; color: var(--mhk-gray-900); -unity-text-align: middle-left; }
.onl-bar-track { flex-grow: 1; height: 8px; border-radius: 4px; background-color: var(--mhk-gray-200); overflow: hidden; }
.onl-bar-fill { height: 100%; border-radius: 4px; background-color: var(--mhk-accent); }
.onl-row.full .onl-bar-fill { background-color: var(--mhk-bad-ink); }
.onl-col-phase { width: 232px; flex-shrink: 0; flex-direction: row; align-items: center; padding-left: 8px; }
.icon.onl-row-phase-icon { width: 24px; height: 24px; margin-right: 8px; flex-shrink: 0; -unity-background-image-tint-color: var(--mhk-gray-600); }
.onl-row-phase { -unity-font-definition: var(--font-bold); font-size: 18px; color: var(--mhk-gray-700); -unity-text-align: middle-left; }
.onl-col-join { width: 112px; flex-shrink: 0; align-items: flex-end; }
.onl-join-pill { flex-direction: row; align-items: center; height: 36px; padding: 0 16px 0 12px; border-radius: 18px; background-color: var(--mhk-gray-800); }
.onl-join-pill .icon { width: 22px; height: 22px; margin-right: 6px; -unity-background-image-tint-color: var(--mhk-accent); }
.onl-row .onl-join-label { -unity-font-definition: var(--font-bold); font-size: 18px; color: var(--mhk-white); }
.onl-row:hover .onl-join-pill, .onl-row:focus .onl-join-pill { background-color: var(--mhk-accent); }
.onl-row:hover .onl-join-pill .icon, .onl-row:focus .onl-join-pill .icon { -unity-background-image-tint-color: var(--mhk-gray-900); }
.onl-row:hover .onl-join-label, .onl-row:focus .onl-join-label { color: var(--mhk-gray-900); }
.onl-row .pack-logo { width: 48px; height: 22px; }
/* Narrow tables (4:3) leave the logos out: the name and its tooltip tell the set (OnlineScreen.FitLogos). */
.onl-list.no-logos .pack-logos { display: none; }
.onl-none { font-size: 18px; color: var(--mhk-gray-500); padding: 0; margin: 16px 0 0 0; }
.panel.onl-side { width: 432px; flex-shrink: 0; margin-left: 16px; padding: 16px 24px 24px 24px; }
.onl-side-head { flex-direction: row; align-items: center; height: 32px; margin-bottom: 16px; }
.icon.onl-side-icon { width: 28px; height: 28px; margin-right: 8px; -unity-background-image-tint-color: var(--mhk-gray-700); }
.onl-side-title { -unity-font-definition: var(--font-display); font-size: 28px; color: var(--mhk-gray-900); margin: 0; padding: 0; }
.onl-code-row { flex-direction: row; align-items: center; }
.acc-input.onl-code { flex-grow: 1; flex-shrink: 1; margin: 0 8px 0 0; }
.acc-input.onl-code .unity-text-element { -unity-font-definition: var(--font-display); font-size: 28px; letter-spacing: 4px; }
.mhk-button.onl-code-join { margin: 0; }
.onl-or { flex-direction: row; align-items: center; margin: 16px 0; }
.onl-or-line { flex-grow: 1; height: 1px; background-color: var(--mhk-divider); }
.onl-or-label { font-size: 16px; color: var(--mhk-gray-500); margin: 0 16px; padding: 0; }
.mhk-button.big.onl-create { margin: 0; }
.onl-login { display: none; flex-grow: 1; align-items: center; justify-content: center; padding: 24px; }
.onl-login-label { font-size: 22px; color: var(--mhk-gray-700); white-space: normal; -unity-text-align: middle-center; margin-bottom: 16px; }
.onl-logged-out .onl-login, .preview-logged-out .onl-login { display: flex; }
.onl-logged-out .onl-browser, .preview-logged-out .onl-browser { display: none; }

/* Track page in the lobby modes: the Random card and the votes per card. */
.icon.random-card-icon { position: absolute; left: 30%; right: 30%; top: 18%; bottom: 30%; width: auto; height: auto; -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: var(--mhk-gray-600); }
.vote-badge { position: absolute; left: 14px; top: 14px; }
.header.vote-header { flex-direction: row; }
.vote-timer { flex-direction: row; align-items: center; margin-left: 16px; padding: 4px 16px 6px 12px; border-radius: 26px; background-color: var(--mhk-accent); border-width: 2px; border-color: var(--mhk-accent-deep); }
.vote-timer .icon { width: 34px; height: 34px; margin-right: 6px; -unity-background-image-tint-color: var(--mhk-gray-900); }
.vote-timer-label { -unity-font-definition: var(--font-display); font-size: 40px; color: var(--mhk-gray-900); min-width: 46px; -unity-text-align: middle-center; margin: 0; padding: 0; }
.vote-badge .info-chip { background-color: var(--mhk-accent); }
.vote-badge .info-chip-icon, .vote-badge .info-chip.on .info-chip-icon { -unity-background-image-tint-color: var(--mhk-gray-900); }

/* Room settings: mode, mods as toggle cards, rules as switches / chips / steppers, the summary chips. */
.room-body { flex-grow: 1; flex-direction: row; min-height: 0; }
.panel.room-left { flex-grow: 1; flex-shrink: 1; flex-basis: 0; max-height: 100%; padding: 16px; }
.panel.room-right { width: 640px; flex-shrink: 1; margin-left: 16px; max-height: 100%; padding: 8px 16px 16px 16px; }
.room-name-row { flex-direction: row; align-items: center; flex-shrink: 0; }
.icon.room-row-icon { width: 28px; height: 28px; margin-right: 16px; flex-shrink: 0; -unity-background-image-tint-color: var(--mhk-gray-600); }
.acc-input.room-name { flex-grow: 1; margin: 0; }
.tabs.room-tabs { align-self: flex-start; margin: 16px 0 8px 0; }
.setting-row.room-cup { flex-shrink: 0; }
.room-mod-scroll { flex-shrink: 1; flex-grow: 1; }
.card-grid.room-mod-grid { justify-content: flex-start; }
.card.room-mod-card { width: 232px; height: 204px; justify-content: center; padding: 20px 18px 18px 18px; opacity: 0.62; }
.card.room-mod-card.selected, .card.room-mod-card:focus, .card.room-mod-card:hover { opacity: 1; }
.pack-logo.room-mod-logo { width: 160px; height: 72px; margin: 0 0 8px 0; }
.room-mod-name { -unity-font-definition: var(--font-bold); font-size: 22px; color: var(--mhk-gray-900); -unity-text-align: middle-center; padding: 0; margin: 0 0 4px 0; }
.room-mod-chips { justify-content: center; }
.room-rule-scroll { flex-shrink: 1; flex-grow: 1; }
.room-row { flex-direction: row; align-items: center; min-height: 56px; padding: 4px 0; border-bottom-width: 1px; border-color: var(--mhk-divider); }
.room-row-label { flex-grow: 1; flex-shrink: 0; min-width: 150px; -unity-font-definition: var(--font-bold); font-size: 21px; color: var(--mhk-gray-800); padding: 0; margin: 0; }
.room-row .mhk-switch { margin: 0; }
.tabs.room-seg { margin: 0; align-self: auto; }
.room-stepper { flex-direction: row; align-items: center; }
.room-stepper-value { min-width: 96px; -unity-font-definition: var(--font-display); font-size: 28px; color: var(--mhk-gray-900); -unity-text-align: middle-center; padding: 0; margin: 0; }
.mhk-button.small.icon-only.room-step { min-width: 52px; margin: 0; }
.setting-row.room-odds { flex-grow: 0; flex-shrink: 0; width: 320px; margin: 0; padding: 0; min-height: 0; }
.room-summary { flex-shrink: 0; margin-top: 16px; padding-top: 16px; border-top-width: 1px; border-color: var(--mhk-divider); }

/* Lobby: header with code and rules, phase banner, player cards and free slots, the side panel. */
.lob-header { flex-direction: row; align-items: center; justify-content: center; }
.lob-code-box { flex-direction: row; align-items: center; margin-left: 16px; padding: 4px 8px 4px 16px; border-radius: 16px; }
.icon.lob-code-icon { width: 26px; height: 26px; margin-right: 6px; -unity-background-image-tint-color: var(--mhk-gray-600); }
.lob-code { -unity-font-definition: var(--font-display); font-size: 38px; color: var(--mhk-gray-900); letter-spacing: 4px; margin: 0 8px 0 0; padding: 0; }
.lob-code-box .mhk-button.small.icon-only { min-width: 48px; margin: 0 0 0 4px; }
.info-chips.lob-settings { margin: 8px 0 0 0; }
.lob-body { flex-grow: 1; flex-direction: row; min-height: 0; }
.lob-left { flex-grow: 1; flex-shrink: 1; flex-basis: 0; max-height: 100%; }
.panel.lob-banner { flex-direction: row; align-items: center; flex-shrink: 0; padding: 16px 24px; margin-bottom: 16px; }
.lob-banner > .icon { width: 40px; height: 40px; margin-right: 16px; flex-shrink: 0; -unity-background-image-tint-color: var(--mhk-gray-700); }
.lob-banner-text { flex-grow: 1; flex-shrink: 1; }
.lob-phase { -unity-font-definition: var(--font-display); font-size: 34px; color: var(--mhk-gray-900); margin: 0; padding: 0; }
.lob-phase-sub { font-size: 17px; color: var(--mhk-gray-500); white-space: normal; margin: 0; padding: 0; }
.lob-countdown { -unity-font-definition: var(--font-display); font-size: 52px; color: var(--mhk-accent-deep); min-width: 80px; -unity-text-align: middle-right; margin: 0; padding: 0; }
.lob-members-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.lob-members { flex-direction: row; flex-wrap: wrap; }
.mem-card { width: 18.4%; height: 292px; margin: 0 16px 16px 0; padding: 12px 12px 12px 12px; align-items: center; border-radius: 20px; background-color: var(--mhk-glass-fill); border-width: 1px; border-color: var(--mhk-glass-rim); border-top-color: var(--mhk-glass-rim-top); }
.mem-card.mine, TemplateContainer.sample-mine > .mem-card { border-width: 3px; border-color: var(--mhk-accent); background-color: rgb(255, 238, 200); }
.mem-card.waiting { opacity: 0.72; }
.mem-top { flex-direction: row; justify-content: space-between; align-items: center; align-self: stretch; height: 30px; }
.mem-origin { flex-direction: row; align-items: center; }
.icon.mem-platform { width: 22px; height: 22px; margin-left: 0; -unity-background-image-tint-color: var(--mhk-gray-600); }
.mem-country { -unity-font-definition: var(--font-bold); font-size: 15px; color: var(--mhk-gray-700); padding: 2px 8px; margin: 0 8px 0 0; border-radius: 8px; background-color: var(--mhk-row-hover); }
.mem-ping .info-chip { margin: 0; }
.mem-driver { width: 124px; height: 124px; margin-top: 2px; flex-shrink: 0; }
.mem-portrait { width: 124px; height: 124px; flex-shrink: 0; border-radius: 62px; background-color: var(--mhk-gray-100); -unity-background-scale-mode: scale-and-crop; border-width: 3px; border-color: var(--mhk-white); }
.mem-kart { position: absolute; right: -16%; bottom: -6%; width: 64px; height: 64px; border-radius: 32px; background-color: var(--mhk-white); -unity-background-scale-mode: scale-to-fit; border-width: 2px; border-color: var(--mhk-gray-200); }
.mem-name { -unity-font-definition: var(--font-bold); font-size: 24px; color: var(--mhk-gray-900); margin: 8px 0 0 0; padding: 0; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.info-chips.mem-badges { justify-content: center; min-height: 32px; }
.mem-badges .info-chip { margin: 1px 2px; }
.mem-points { -unity-font-definition: var(--font-display); font-size: 36px; color: var(--mhk-gray-900); margin: 0; padding: 0; }
/* Short cards (wide phone screens: LobbyScreen.FitCards). */
.mem-card.compact { padding: 8px 10px 10px 10px; }
.mem-card.compact .mem-top { height: 26px; }
.mem-card.compact .mem-name { font-size: 20px; margin-top: 4px; }
.mem-card.compact .mem-points { font-size: 28px; }
.mem-card.compact .info-chips.mem-badges { min-height: 28px; }
/* The free places: one quiet tile (LobbyScreen.FreeTile), as high as the cards. */
.mem-free-tile { width: 18.4%; height: 292px; margin: 0 16px 16px 0; align-items: center; justify-content: center; border-radius: 20px; border-width: 2px; border-color: rgba(255, 255, 255, 0.4); background-color: rgba(255, 255, 255, 0.12); }
.icon.mem-free-icon { width: 40px; height: 40px; -unity-background-image-tint-color: rgba(255, 255, 255, 0.75); }
.mem-free-count { -unity-font-definition: var(--font-display); font-size: 34px; color: var(--mhk-white); -unity-text-outline: 2px var(--mhk-outline); margin: 2px 0 0 0; padding: 0; }
.mem-free-label { -unity-font-definition: var(--font-bold); font-size: 16px; color: var(--mhk-white); -unity-text-outline: 1px var(--mhk-outline); margin: 0; padding: 0; }
.mhk-button.small.icon-only.mem-kick { position: absolute; right: 8px; bottom: 8px; min-width: 44px; min-height: 40px; margin: 0; }
.panel.lob-side { width: 420px; flex-shrink: 0; margin-left: 16px; max-height: 100%; padding: 16px 16px 16px 16px; align-self: stretch; }
.lob-loadout { flex-direction: row; align-items: center; }
.lob-loadout-portrait { width: 88px; height: 88px; flex-shrink: 0; border-radius: 44px; background-color: var(--mhk-gray-100); -unity-background-scale-mode: scale-and-crop; border-width: 3px; border-color: var(--mhk-white); }
.lob-loadout-kart-icon { width: 48px; height: 48px; flex-shrink: 0; margin-left: -24px; margin-top: 40px; border-radius: 24px; background-color: var(--mhk-white); -unity-background-scale-mode: scale-to-fit; border-width: 2px; border-color: var(--mhk-gray-200); }
.lob-loadout-text { flex-grow: 1; flex-shrink: 1; margin-left: 16px; }
.lob-loadout-name { -unity-font-definition: var(--font-bold); font-size: 24px; color: var(--mhk-gray-900); padding: 0; margin: 0; }
.lob-loadout-kart { font-size: 17px; color: var(--mhk-gray-500); padding: 0; margin: 0; }
.mhk-button.lob-pick { flex-shrink: 0; margin: 8px 0 0 0; }
.lob-actions { flex-shrink: 0; margin-top: 8px; }
.lob-actions .mhk-button { margin: 8px 0 0 0; }
.lob-results-box { flex-grow: 1; flex-shrink: 1; min-height: 0; margin-top: 16px; padding-top: 8px; border-top-width: 1px; border-color: var(--mhk-divider); }
.lob-results-head { flex-direction: row; align-items: center; margin-bottom: 4px; }
.icon.lob-results-icon { width: 24px; height: 24px; margin-right: 6px; -unity-background-image-tint-color: var(--mhk-gray-600); }
.lob-results-title { -unity-font-definition: var(--font-bold); font-size: 18px; color: var(--mhk-gray-600); padding: 0; margin: 0; }
.lob-results { flex-shrink: 1; min-height: 0; }
.lob-result-row { flex-direction: row; align-items: center; padding: 3px 8px; border-radius: 10px; margin-bottom: 2px; }
.lob-result-row.mine { background-color: var(--mhk-accent-soft); }
.lob-result-pos { width: 34px; height: 30px; flex-shrink: 0; margin: 0 8px 0 0; padding: 0; border-radius: 15px; -unity-font-definition: var(--font-display); font-size: 20px; color: var(--mhk-gray-700); -unity-text-align: middle-center; background-color: var(--mhk-row-hover); }
.lob-result-row.medal-1 .lob-result-pos { background-image: url("Textures/badge_gold.png"); background-color: transparent; color: var(--mhk-gray-900); }
.lob-result-row.medal-2 .lob-result-pos { background-image: url("Textures/badge_silver.png"); background-color: transparent; color: var(--mhk-gray-900); }
.lob-result-row.medal-3 .lob-result-pos { background-image: url("Textures/badge_bronze.png"); background-color: transparent; color: var(--mhk-gray-900); }
.lob-result-name { flex-grow: 1; flex-shrink: 1; -unity-font-definition: var(--font-bold); font-size: 18px; color: var(--mhk-gray-900); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding: 0; margin: 0; }
.lob-result-time { width: 100px; flex-shrink: 0; font-size: 17px; color: var(--mhk-gray-600); -unity-text-align: middle-right; padding: 0; margin: 0; }
.lob-result-points { width: 54px; flex-shrink: 0; -unity-font-definition: var(--font-display); font-size: 20px; color: var(--mhk-gray-900); -unity-text-align: middle-right; padding: 0; margin: 0; }

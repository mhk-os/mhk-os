<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- Pause menu (shown state: code removes .shown from panel and adds it back to scale it in). Options opens the menu's Options page over the scrim; code hides panel meanwhile.
         Championships from the second race on: Standings (hidden otherwise) swaps panel for standings-column, the standings before this race (Race/Templates/Standings.uxml); Back, Cancel or the Pause key return. Screenshot (offline races, championships and battles; hidden otherwise) opens the photo mode (Photo.uxml), which hides this screen meanwhile. Preview class on pause: preview-standings (standings-column instead of panel). -->
    <ui:Style src="/Assets/MHK/UI/MHKTheme.uss" />
    <ui:Template name="Standings" src="/Assets/MHK/UI/Race/Templates/Standings.uxml" />
    <ui:VisualElement name="pause" class="screen hud-pause">
        <ui:VisualElement class="vignette" />
        <ui:VisualElement name="panel" class="hud-pause-column shown">
            <ui:Label name="title" text="Paused" class="page-title hud-pause-title" />
            <ui:VisualElement class="panel hud-pause-panel">
                <ui:Button name="continue" class="mhk-button go">
                    <ui:VisualElement class="icon i-play_arrow" />
                    <ui:Label text="Continue" class="button-label" />
                </ui:Button>
                <ui:Button name="standings" class="mhk-button">
                    <ui:VisualElement class="icon i-leaderboard" />
                    <ui:Label text="Standings" class="button-label" />
                </ui:Button>
                <ui:Button name="photo" class="mhk-button">
                    <ui:VisualElement class="icon i-photo_camera" />
                    <ui:Label text="Screenshot" class="button-label" />
                </ui:Button>
                <ui:Button name="restart" class="mhk-button">
                    <ui:VisualElement class="icon i-restart_alt" />
                    <ui:Label text="Restart" class="button-label" />
                </ui:Button>
                <ui:Button name="options" class="mhk-button">
                    <ui:VisualElement class="icon i-settings" />
                    <ui:Label text="Options" class="button-label" />
                </ui:Button>
                <ui:Button name="end-race" class="mhk-button danger">
                    <ui:VisualElement class="icon i-person_add" />
                    <ui:Label name="end-race-label" text="End race" class="button-label" />
                </ui:Button>
                <ui:Button name="quit" class="mhk-button secondary">
                    <ui:VisualElement class="icon i-home" />
                    <ui:Label text="Quit to menu" class="button-label" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="standings-column" class="hud-pause-column hud-pause-standings shown">
            <ui:Label name="standings-title" text="Standings" class="page-title hud-pause-title" />
            <ui:Instance template="Standings" name="standings-page" class="hud-standings-page" />
            <ui:VisualElement class="row hud-results-buttons">
                <ui:Button name="standings-back" class="mhk-button go">
                    <ui:VisualElement class="icon i-arrow_back" />
                    <ui:Label text="Back" class="button-label" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

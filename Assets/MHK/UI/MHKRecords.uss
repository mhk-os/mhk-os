/* Time trial pages (imported by MHKTheme.uss): the Records side panel, one track's records (your ghosts and the online
 * leaderboard side by side, one at a time on narrow screens: .narrow on the page), the ghost picker's pill, the
 * moderators' Reports page and the text prompt. Big numbers (times, ranks) use the display font, metadata is small
 * and muted, explanations live in tooltips. Elements that code shows only in some states are hidden here (code sets
 * their display inline); the preview-* classes show those states in UI Builder. Chips: .info-chip (MHKOnline.uss). */

.i-history { background-image: url("Icons/history.png"); }
.i-search { background-image: url("Icons/search.png"); }
.i-toggle_on { background-image: url("Icons/toggle_on.png"); }
.i-toggle_off { background-image: url("Icons/toggle_off.png"); }

/* ---- Records: the side panel sums up the focused track. ---- */
.panel.records-side { padding: 14px 16px 16px 16px; }
.rec-picture { height: 168px; border-radius: 12px; background-size: cover; background-color: var(--mhk-row); flex-shrink: 0; }
.rec-side-head { flex-direction: row; align-items: center; margin: 8px 0 6px 0; }
.rec-side-names { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.rec-side-head .records-ghosts-title { margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rec-side-game { font-size: 15px; color: var(--mhk-gray-500); padding: 0; margin: 0; }
.info-chips.rec-chips { flex-shrink: 0; }
.rec-classes { margin: 2px 0 8px 0; }
.rec-class-line { flex-direction: row; align-items: center; min-height: 48px; padding: 2px 10px 2px 6px; margin: 2px 0; border-radius: 10px; background-color: var(--mhk-row); }
.info-chip.rec-class-chip { height: 34px; border-radius: 17px; margin: 0 8px 0 0; background-color: rgba(23, 25, 29, 0.07); }
.rec-class-chip .info-chip-label { font-size: 17px; }
.rec-class-driver { flex-shrink: 0; }
.rec-class-driver .driver-icon { width: 36px; height: 36px; }
.rec-class-time { flex-grow: 1; -unity-font-definition: var(--font-display); font-size: 28px; color: var(--mhk-gray-900); -unity-text-align: middle-right; padding: 0; margin: 0 0 0 8px; }
.rec-class-line.empty .rec-class-time { color: var(--mhk-gray-400); }
.rec-side-actions { flex-direction: row; align-items: center; justify-content: space-between; flex-wrap: wrap; }
/* Toggle and account chip: pill buttons with an icon, accent ring when focused. */
.rec-toggle, .rec-account-chip {
    flex-direction: row; align-items: center; flex-shrink: 1; min-height: 44px; margin: 4px 0; padding: 2px 14px 2px 10px;
    border-radius: 22px; border-width: 2px; border-color: transparent; background-image: none; background-color: var(--mhk-row-hover);
}
.rec-toggle:hover, .rec-account-chip:hover { background-color: rgba(23, 25, 29, 0.14); }
.rec-toggle:focus, .rec-account-chip:focus { border-color: var(--mhk-accent); }
.icon.rec-toggle-icon { width: 40px; height: 40px; margin-right: 6px; -unity-background-image-tint-color: var(--mhk-gray-500); }
.rec-toggle.on .rec-toggle-icon { -unity-background-image-tint-color: var(--mhk-accent-deep); }
.rec-toggle-label, .rec-account-label { -unity-font-definition: var(--font-bold); font-size: 18px; color: var(--mhk-gray-800); padding: 0; margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.icon.rec-account-icon { width: 26px; height: 26px; margin-right: 6px; -unity-background-image-tint-color: var(--mhk-gray-600); }
.rec-account-chip.online { background-color: rgba(24, 121, 78, 0.14); }
.rec-account-chip.online .rec-account-icon { -unity-background-image-tint-color: var(--mhk-good-ink); }
.mhk-button.trk-reports { display: none; }
.preview-mod .mhk-button.trk-reports { display: flex; }

/* ---- One track's records: toolbar. ---- */
.trk-browser { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.panel.trk-toolbar { flex-direction: row; align-items: center; flex-wrap: wrap; padding: 8px 12px; margin-bottom: 10px; flex-shrink: 0; }
.trk-picture { width: 104px; height: 60px; border-radius: 10px; background-size: cover; background-color: var(--mhk-row); flex-shrink: 0; margin-right: 12px; }
.trk-heading { flex-grow: 1; flex-shrink: 1; min-width: 150px; }
.trk-name { -unity-font-definition: var(--font-display); font-size: 28px; color: var(--mhk-gray-900); padding: 0; margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.trk-game { font-size: 14px; color: var(--mhk-gray-500); padding: 0; margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tabs.trk-classes, .tabs.trk-sections, .tabs.fr-filter { margin: 0 6px; align-self: center; }
.tabs.trk-sections { display: none; }
.narrow .tabs.trk-sections, .preview-narrow .tabs.trk-sections { display: flex; }
/* Compact dropdowns (version, region, kart, driver): the value button only, the name is the tooltip. */
.setting-row.trk-filter { min-width: 0; min-height: 0; padding: 0; margin: 2px 6px 2px 0; flex-shrink: 1; }
.trk-filter .setting-label { display: none; }
.trk-filter .mhk-button { min-width: 0; min-height: 42px; flex-shrink: 1; margin: 0; font-size: 18px; }
.trk-filter .button-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex-shrink: 1; }
.setting-row.trk-version { margin: 0 6px; flex-shrink: 0; }
.trk-version .mhk-button, .trk-version .button-label { flex-shrink: 0; }
/* The version names its entry in full (text measuring ignores the buttons' letter spacing, so no ellipsis here). */
.trk-version .button-label { overflow: visible; text-overflow: clip; padding-right: 8px; }
/* Pick pill: how many ghosts are picked for the race, with clear. Accent once something is picked. */
.trk-pick-pill { flex-direction: row; align-items: center; height: 42px; padding: 0 4px 0 12px; margin-left: 6px; border-radius: 21px; background-color: var(--mhk-accent); }
.trk-pick-pill.empty { background-color: var(--mhk-row-hover); }
.trk-pick-pill.full { background-color: var(--mhk-accent-deep); }
.icon.trk-pick-icon { width: 22px; height: 22px; margin-right: 6px; -unity-background-image-tint-color: var(--mhk-gray-900); }
.trk-pick-count { -unity-font-definition: var(--font-bold); font-size: 18px; color: var(--mhk-gray-900); padding: 0; margin: 0 6px 0 0; }
.trk-pick-pill.empty .trk-pick-count, .trk-pick-pill.empty .trk-pick-icon { color: var(--mhk-gray-600); -unity-background-image-tint-color: var(--mhk-gray-600); }
.trk-pick-clear { width: 34px; height: 34px; margin: 0; padding: 0; border-radius: 17px; border-width: 2px; border-color: transparent; background-image: none; background-color: rgba(23, 25, 29, 0.12); align-items: center; justify-content: center; }
.trk-pick-clear:hover { background-color: rgba(23, 25, 29, 0.24); }
.trk-pick-clear:focus { border-color: var(--mhk-gray-900); }
.trk-pick-clear .icon { width: 20px; height: 20px; -unity-background-image-tint-color: var(--mhk-gray-900); }
.trk-pick-clear:disabled { display: none; }
.ghost-toolbar .trk-pick-pill { margin-left: 0; padding-right: 12px; }

/* ---- Columns: your ghosts and the leaderboard. ---- */
.trk-columns { flex-direction: row; flex-grow: 1; flex-shrink: 1; min-height: 0; align-items: stretch; }
.panel.trk-local { width: 40%; flex-shrink: 1; margin-right: 12px; padding: 12px 12px 12px 12px; }
.panel.trk-global { flex-grow: 1; flex-shrink: 1; flex-basis: 0; padding: 12px 12px 12px 12px; }
.narrow .panel.trk-local, .preview-narrow .panel.trk-local { width: auto; flex-grow: 1; flex-basis: 0; margin-right: 0; }
.narrow.show-global .panel.trk-local, .narrow.show-local .panel.trk-global { display: none; }
.preview-narrow .panel.trk-global { display: none; }
.trk-section-head { flex-direction: row; align-items: center; flex-wrap: wrap; min-height: 34px; margin: 0 2px 6px 2px; flex-shrink: 0; }
.trk-section-title { -unity-font-definition: var(--font-display); font-size: 24px; color: var(--mhk-gray-900); padding: 0; margin: 0 10px 0 0; white-space: nowrap; flex-shrink: 0; }
.info-chips.trk-head-chips { flex-grow: 1; justify-content: flex-end; }
.trk-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; }
/* The status line sits below the panels over the race behind the menu, so it gets its own small plate. */
.records-status.trk-status { margin-top: 6px; flex-shrink: 0; align-self: center; padding: 3px 14px 5px 14px; border-radius: 12px; background-color: var(--mhk-glass-lite-fill); font-size: 17px; color: var(--mhk-gray-800); }

/* Your ghosts (GhostRow in the records list): check, time, who, driver, class chip, badges, icon actions. */
.trk-local .ghost-scroll { flex-grow: 1; }
.ghost-list-records .ghost-row { margin: 2px 0; }
.ghost-list-records .ghost-main { padding: 4px 30px 4px 8px; }
.trk-local .ghost-list-records .ghost-check { display: flex; width: 28px; height: 28px; margin-right: 8px; flex-shrink: 0; }
.trk-local .ghost-list-records .ghost-time { width: 100px; font-size: 24px; }
.ghost-list-records .ghost-info { min-width: 60px; }
.ghost-list-records .ghost-player { font-size: 16px; }
.ghost-list-records .ghost-date { font-size: 12px; }
.ghost-list-records .ghost-driver { margin: 0 6px; }
.ghost-list-records .driver-icon { width: 32px; height: 32px; }
.ghost-list-records .ghost-class, .ghost-list .ghost-class {
    min-width: 0; padding: 1px 9px 3px 9px; border-radius: 12px; background-color: rgba(23, 25, 29, 0.08);
    -unity-font-definition: var(--font-bold); font-size: 15px; color: var(--mhk-gray-700); -unity-text-align: middle-center;
}
.ghost-list-records .ghost-badges { top: 3px; right: 6px; }
.ghost-list-records .icon.ghost-badge { width: 18px; height: 18px; }
.ghost-list-records .ghost-actions { margin-left: 2px; }
.ghost-list-records .ghost-actions .mhk-button.icon-only { min-width: 44px; min-height: 40px; padding: 2px 6px 6px 6px; margin: 2px 1px; }
.ghost-list-records .ghost-actions .icon { width: 22px; height: 22px; }
.ghost-upload, .ghost-uploaded { flex-shrink: 0; }
.ghost-uploaded { display: none; flex-direction: row; align-items: center; height: 30px; margin: 4px 2px; padding: 0 9px 0 6px; border-radius: 15px; background-color: rgba(24, 121, 78, 0.14); }
.ghost-uploaded .icon { width: 18px; height: 18px; margin-right: 3px; -unity-background-image-tint-color: var(--mhk-good-ink); }
.ghost-uploaded-label { -unity-font-definition: var(--font-bold); font-size: 15px; color: var(--mhk-good-ink); padding: 0; margin: 0; }
TemplateContainer.sample-uploaded > .ghost-row .ghost-uploaded { display: flex; }
TemplateContainer.sample-uploaded > .ghost-row .ghost-upload { display: none; }
.ghost-kind.online { background-image: url("Icons/cloud_download.png"); -unity-background-image-tint-color: var(--mhk-gray-500); }
.lb-state.trk-empty { flex-grow: 1; }

/* ---- Leaderboard: filters, own row, rows, state and pager. ---- */
.lb-filters { flex-direction: row; align-items: center; flex-wrap: wrap; margin-bottom: 6px; flex-shrink: 0; }
.lb-search-box { flex-direction: row; align-items: center; flex-grow: 1; flex-shrink: 1; min-width: 170px; height: 42px; margin: 2px 6px 2px 0; padding: 0 4px 0 12px; border-radius: 21px; border-width: 2px; border-color: var(--mhk-gray-300); background-color: var(--mhk-white); }
.icon.lb-search-icon { width: 22px; height: 22px; margin-right: 4px; -unity-background-image-tint-color: var(--mhk-gray-500); }
.lb-search { flex-grow: 1; flex-shrink: 1; margin: 0; }
.lb-search .unity-base-text-field__input { -unity-font-definition: var(--font-body); font-size: 18px; min-height: 36px; padding: 0 6px; border-width: 0; background-color: transparent; color: var(--mhk-gray-900); }
.lb-search .unity-base-text-field__input--placeholder { color: var(--mhk-gray-400); }
.lb-list { flex-shrink: 0; }
.lb-mine { display: none; padding-bottom: 4px; margin-bottom: 4px; border-bottom-width: 1px; border-color: var(--mhk-divider); }
.lb-row { flex-direction: row; align-items: center; margin: 2px 0; border-radius: 12px; }
.lb-row.alt { background-color: var(--mhk-row); }
.lb-main {
    flex-grow: 1; flex-shrink: 1;
    flex-direction: row; align-items: center;
    margin: 0; padding: 4px 10px 4px 8px;
    border-width: 2px; border-color: transparent; border-radius: 12px;
    background-color: transparent; background-image: none;
}
.lb-main:hover { background-color: var(--mhk-row-hover); }
.lb-main:focus { border-color: var(--mhk-accent); background-color: var(--mhk-accent-soft); }
.ghost-check.lb-check { width: 28px; height: 28px; margin-right: 8px; flex-shrink: 0; }
.lb-row.selected .ghost-check, TemplateContainer.sample-selected > .lb-row .ghost-check { background-color: var(--mhk-accent); border-color: var(--mhk-accent-deep); }
.lb-row.selected .ghost-check .icon, TemplateContainer.sample-selected > .lb-row .ghost-check .icon { opacity: 1; }
/* Rank: a plain number, the top three on a medal disc. */
.lb-rank { width: 40px; height: 40px; flex-shrink: 0; margin-right: 8px; border-radius: 20px; -unity-font-definition: var(--font-display); font-size: 24px; color: var(--mhk-gray-700); -unity-text-align: middle-center; padding: 0; }
.lb-rank.medal-1, TemplateContainer.sample-gold .lb-rank { background-color: #F6C445; color: var(--mhk-gray-900); border-width: 2px; border-color: #C98A00; }
.lb-rank.medal-2 { background-color: #D3D8DE; color: var(--mhk-gray-900); border-width: 2px; border-color: #9AA2AC; }
.lb-rank.medal-3 { background-color: #DDA77C; color: var(--mhk-gray-900); border-width: 2px; border-color: #A86E43; }
.lb-driver { margin-right: 10px; }
.lb-driver .driver-icon { width: 40px; height: 40px; margin-left: 2px; }
.lb-who { flex-grow: 1; flex-shrink: 1; min-width: 80px; }
.lb-name-row { flex-direction: row; align-items: center; }
.lb-name { -unity-font-definition: var(--font-bold); font-size: 21px; color: var(--mhk-gray-900); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex-shrink: 1; padding: 0; margin: 0; -unity-text-align: middle-left; }
.lb-you { display: none; flex-shrink: 0; margin-left: 6px; padding: 0 7px 1px 7px; border-radius: 9px; background-color: var(--mhk-accent); -unity-font-definition: var(--font-bold); font-size: 13px; color: var(--mhk-gray-900); }
.lb-country { flex-shrink: 0; margin-left: 6px; padding: 0 6px 1px 6px; border-radius: 6px; background-color: var(--mhk-row-hover); -unity-font-definition: var(--font-bold); font-size: 13px; color: var(--mhk-gray-600); }
.lb-sub { display: none; font-size: 14px; color: var(--mhk-gray-500); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding: 0; margin: 0; -unity-text-align: middle-left; }
/* Badges: small icon pills, the meaning is the tooltip. */
.lb-badges { flex-direction: row; align-items: center; flex-shrink: 0; margin: 0 6px; }
.lb-badge { display: none; flex-direction: row; align-items: center; height: 26px; min-width: 26px; padding: 0 5px; margin-left: 4px; border-radius: 13px; justify-content: center; }
.lb-badge .icon { width: 16px; height: 16px; }
.lb-badge-label { -unity-font-definition: var(--font-bold); font-size: 14px; color: var(--mhk-white); padding: 0 0 0 2px; margin: 0; }
.lb-flags { background-color: var(--mhk-bad-ink); }
.lb-flags .icon { -unity-background-image-tint-color: var(--mhk-white); }
.lb-mismatch { background-color: var(--mhk-accent-soft); }
.lb-mismatch .icon { -unity-background-image-tint-color: var(--mhk-accent-deep); }
.lb-hidden { background-color: var(--mhk-gray-700); }
.lb-hidden .icon { -unity-background-image-tint-color: var(--mhk-white); }
.lb-row.flagged .lb-flags, TemplateContainer.sample-flagged > .lb-row .lb-flags { display: flex; }
.lb-row.mismatch .lb-mismatch, TemplateContainer.sample-mismatch > .lb-row .lb-mismatch { display: flex; }
.lb-row.hidden-run .lb-hidden, TemplateContainer.sample-hidden > .lb-row .lb-hidden { display: flex; }
.lb-row.hidden-run .lb-main, TemplateContainer.sample-hidden > .lb-row .lb-main { opacity: 0.6; }
.lb-row.mine .lb-you, TemplateContainer.sample-mine > .lb-row .lb-you { display: flex; }
.lb-row.mine, TemplateContainer.sample-mine > .lb-row { background-color: var(--mhk-accent-soft); }
/* Time big, best lap small below it. */
.lb-times { width: 128px; flex-shrink: 0; align-items: flex-end; }
.lb-time { -unity-font-definition: var(--font-display); font-size: 28px; color: var(--mhk-gray-900); padding: 0; margin: 0; -unity-text-align: middle-right; }
.lb-lap-box { flex-direction: row; align-items: center; }
.lb-lap-box .icon { width: 14px; height: 14px; margin-right: 3px; -unity-background-image-tint-color: var(--mhk-gray-400); }
.lb-lap { font-size: 14px; color: var(--mhk-gray-500); padding: 0; margin: 0; }
.lb-actions { flex-shrink: 0; margin-left: 2px; }
.lb-actions .mhk-button.icon-only { min-width: 46px; min-height: 42px; padding: 2px 6px 6px 6px; margin: 2px 1px; }
.lb-actions .icon { width: 22px; height: 22px; }
.lb-mod-action { display: none; }
.lb-list-mod .lb-mod-action, .preview-mod .lb-mod-action { display: flex; }
.lb-list-reports .lb-check, .lb-list-reports .lb-rank { display: none; }
.lb-list-reports .lb-sub { display: flex; }
.lb-list-reports .lb-row.selected { background-color: var(--mhk-accent-soft); }
/* Empty, loading and offline states: one icon and one short line. */
.lb-state { display: none; flex-grow: 1; align-items: center; justify-content: center; padding: 18px; }
.preview-state .lb-state { display: flex; }
.preview-state .trk-global .trk-scroll, .preview-state .lb-mine, .preview-state .fr-list-panel .trk-scroll { display: none; }
.icon.lb-state-icon { width: 52px; height: 52px; margin-bottom: 4px; -unity-background-image-tint-color: var(--mhk-gray-400); }
.lb-state-label { -unity-font-definition: var(--font-bold); font-size: 19px; color: var(--mhk-gray-500); white-space: normal; -unity-text-align: middle-center; margin-bottom: 6px; }
.lb-pager { flex-direction: row; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 4px; }
.lb-range { min-width: 140px; font-size: 16px; color: var(--mhk-gray-600); -unity-text-align: middle-center; }
.narrow .lb-driver .driver-kart { display: none; }

/* The ghost picker's empty state. */
.ghosts-panel .lb-state.ghost-empty { flex-grow: 1; }

/* ---- Reports (moderators). ---- */
.panel.fr-list-panel { width: 58%; flex-shrink: 1; margin-right: 12px; padding: 12px; }
.panel.fr-side { flex-grow: 1; flex-shrink: 1; flex-basis: 0; padding: 14px 16px; }
.lb-state.fr-detail-empty { display: flex; }
.preview-no-detail .fr-detail { display: none; }
.fr-run-head { flex-direction: row; align-items: center; justify-content: space-between; }
.fr-run-name { -unity-font-definition: var(--font-display); font-size: 30px; color: var(--mhk-gray-900); padding: 0; margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex-shrink: 1; }
.fr-run-time { -unity-font-definition: var(--font-display); font-size: 30px; color: var(--mhk-gray-900); padding: 0; margin: 0 0 0 12px; }
.info-chips.fr-chips { margin: 4px 0 2px 0; }
.fr-heading-row { flex-direction: row; align-items: center; margin: 12px 0 4px 0; padding-bottom: 3px; border-bottom-width: 1px; border-color: var(--mhk-divider); }
.icon.fr-heading-icon { width: 20px; height: 20px; margin-right: 6px; -unity-background-image-tint-color: var(--mhk-gray-500); }
.fr-heading { -unity-font-definition: var(--font-bold); font-size: 16px; color: var(--mhk-gray-600); padding: 0; margin: 0; }
.fr-sub { font-size: 16px; color: var(--mhk-gray-500); white-space: normal; padding: 0; margin: 1px 0; }
.fr-report { padding: 6px 8px; margin: 3px 0; border-radius: 10px; background-color: var(--mhk-row); }
.fr-report.ignored { opacity: 0.55; }
.fr-report-detail { font-size: 15px; color: var(--mhk-gray-600); white-space: normal; padding: 0 2px; margin: 2px 0 0 0; }
.fr-actions { flex-direction: row; flex-wrap: wrap; margin-top: 14px; }
.narrow .panel.fr-list-panel { width: 54%; }

/* ---- Text prompt: the field between the question and the buttons. ---- */
.prompt-input { align-self: stretch; margin: 0 0 14px 0; }

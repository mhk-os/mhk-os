/* Loading screen (Loading.uxml, LoadingScreen on the GameRoot, SceneFlow shows it while scenes load), imported by
 * MHKTheme.uss right after MHKMenu.uss. Opaque: it hides the scene change. Fades in (code removes .out a frame after
 * opening) and out (code adds .out), LoadingScreen.fadeInSeconds / fadeOutSeconds match the durations.
 * Layers: the track picture blown up as a backdrop (slowly zooming in), a charcoal tint, the vignette and a darker
 * shade behind the footer. On top the layout: white framed preview card (left, tilted with a drop shadow), track
 * details (right), tip plate and progress bar (bottom, checkered flag and percentage at its end). Generic variant
 * (code adds .menu-variant, UI Builder: .preview-menu): the flat menu gray and the logo instead. */
.loading-page {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    background-color: var(--mhk-gray-900);
    overflow: hidden;
    transition-property: opacity;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}
.loading-page.out { opacity: 0; transition-duration: 0.5s; transition-timing-function: ease-in; }
.loading-layout {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    padding: 48px 80px 44px 80px;
    transition-property: scale;
    transition-duration: 0.5s;
    transition-timing-function: ease-out;
}
.loading-page.out .loading-layout { scale: 1.05 1.05; }

/* Backdrop: the .anim entry starts it at scale 1, then the long scale transition zooms it in while the scene loads. */
.loading-backdrop, .loading-menu-backdrop {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    background-size: cover;
    background-position-x: center; background-position-y: center;
}
.loading-backdrop { scale: 1.15 1.15; }
.loading-backdrop.anim { transition-property: opacity, scale; transition-duration: 0.6s, 16s; transition-timing-function: ease-out, linear; }
.loading-backdrop.anim.enter { opacity: 0; scale: 1 1; translate: 0 0; }
/* Square pictures (old MHK2-style previews, e.g. from mod tracks) have a black border: zoomed past it. */
.square-art .loading-backdrop { background-size: 118% auto; }
.loading-menu-backdrop { display: none; background-color: var(--mhk-gray-200); }
.loading-tint { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(23, 25, 29, 0.66); }
.loading-shade {
    position: absolute; left: 0; right: 0; bottom: 0; height: 42%;
    background-image: url("Textures/loading_shade.png");
    background-size: 100% 100%;
}

.loading-race { flex-grow: 1; align-items: center; justify-content: center; }
.loading-card-wrap { flex-shrink: 0; margin-right: 68px; rotate: -2deg; }
.loading-card-shadow {
    position: absolute; left: 12px; top: 18px; right: -12px; bottom: -18px;
    border-radius: 22px;
    background-color: rgba(0, 0, 0, 0.45);
}
.loading-card {
    padding: 12px;
    border-radius: 22px;
    background-color: var(--mhk-white);
}
.loading-preview {
    width: 880px; height: 495px;
    border-radius: 12px;
    background-color: var(--mhk-gray-800);
    background-size: cover;
    background-position-x: center; background-position-y: center;
}
.square-art .loading-preview { background-size: 112% auto; }
.loading-details { flex-shrink: 1; max-width: 780px; align-items: flex-start; }
.ribbon.loading-ribbon { min-width: 0; height: 50px; padding: 0 28px 2px 28px; background-color: var(--mhk-white); border-color: var(--mhk-gray-300); }
.ribbon-label.loading-ribbon-label { font-size: 28px; color: var(--mhk-gray-900); }
.loading-track {
    -unity-font-definition: var(--font-display);
    font-size: 104px;
    color: var(--mhk-white);
    -unity-text-outline: 4px var(--mhk-outline);
    text-shadow: 0 6px 10px var(--mhk-shadow);
    -unity-text-align: middle-left;
    white-space: normal;
    letter-spacing: 1px;
    padding: 0; margin: 10px 0 0 0;
}
.loading-game {
    -unity-font-definition: var(--font-bold);
    font-size: 22px;
    color: var(--mhk-gray-800);
    background-color: var(--mhk-gray-100);
    border-radius: 12px;
    padding: 3px 16px 5px 16px;
    margin: 4px 0 30px 4px;
}
.loading-info { align-items: flex-start; }
.loading-chip {
    align-items: center;
    margin-bottom: 12px;
    padding: 6px 24px 6px 6px;
    border-radius: 32px;
    background-color: var(--mhk-glass);
}
.loading-chip-badge {
    width: 50px; height: 50px;
    margin-right: 14px;
    border-radius: 25px;
    background-color: var(--mhk-white);
    align-items: center; justify-content: center;
}
.icon.loading-chip-icon { width: 30px; height: 30px; -unity-background-image-tint-color: var(--mhk-gray-800); }
.loading-chip-label {
    -unity-font-definition: var(--font-bold);
    font-size: 30px;
    color: var(--mhk-white);
    padding: 0 0 2px 0; margin: 0;
}

.loading-tip {
    align-self: center;
    align-items: center;
    max-width: 1400px;
    margin-bottom: 24px;
    padding: 8px 30px 8px 8px;
    border-radius: 34px;
    background-color: rgba(255, 255, 255, 0.94);
}
.loading-tip-tag {
    flex-shrink: 0;
    align-items: center;
    margin-right: 18px;
    padding: 4px 18px 6px 10px;
    border-radius: 22px;
    background-color: var(--mhk-gray-800);
}
.icon.loading-tip-icon { width: 28px; height: 28px; margin-right: 6px; -unity-background-image-tint-color: var(--mhk-white); }
.loading-tip-tag-label { -unity-font-definition: var(--font-display); font-size: 26px; color: var(--mhk-white); padding: 0; margin: 0; }
.loading-tip-label { flex-shrink: 1; font-size: 24px; color: var(--mhk-gray-800); white-space: normal; padding: 0; margin: 0; }
.loading-progress { align-items: center; }
.loading-bar {
    flex-grow: 1;
    height: 40px;
    padding: 5px;
    border-radius: 20px;
    border-width: 2px; border-color: var(--mhk-white-85);
    background-color: var(--mhk-glass);
}
.loading-bar-fill {
    flex-grow: 1;
    overflow: hidden;
    border-radius: 13px;
    background-color: var(--mhk-white);
}
/* loading_stripes.png: 2048 x 32 with a 32 px period. LoadingScreen scrolls it (no repeat needed). */
.loading-bar-stripes {
    position: absolute; left: 0; top: -6px; width: 2048px; height: 32px;
    background-image: url("Textures/loading_stripes.png");
    background-size: 2048px 32px;
    background-repeat: no-repeat;
    background-position-x: left 0;
    -unity-background-image-tint-color: var(--mhk-gray-300);
}
.loading-flag {
    width: 64px; height: 64px;
    margin-left: -28px;
    border-radius: 32px;
    border-width: 3px; border-color: var(--mhk-white);
    background-color: var(--mhk-gray-800);
    align-items: center; justify-content: center;
}
.icon.loading-flag-icon { width: 38px; height: 38px; -unity-background-image-tint-color: var(--mhk-white); }
.loading-percent {
    width: 120px;
    -unity-font-definition: var(--font-display);
    font-size: 46px;
    color: var(--mhk-white);
    -unity-text-outline: 3px var(--mhk-outline);
    text-shadow: 0 3px 6px var(--mhk-shadow);
    -unity-text-align: middle-right;
    padding: 0; margin: 0;
}

/* Generic variant: the flat menu gray, a soft burst and the logo instead of the race parts (code hides the logo when GameConfig has none). */
.loading-logo-wrap { display: none; flex-grow: 1; align-items: center; justify-content: center; }
.sunburst.loading-logo-burst { left: 50%; top: 50%; width: 1100px; height: 1100px; margin-left: -550px; margin-top: -550px; border-radius: 550px; opacity: 0.5; }
.loading-logo { width: 760px; height: 382px; background-size: contain; }
.preview-menu .loading-logo-wrap, .menu-variant .loading-logo-wrap { display: flex; }
.preview-menu .loading-race, .menu-variant .loading-race,
.preview-menu .loading-backdrop, .menu-variant .loading-backdrop { display: none; }
.preview-menu .loading-menu-backdrop, .menu-variant .loading-menu-backdrop { display: flex; }
.preview-menu .loading-tint, .menu-variant .loading-tint { background-color: rgba(23, 25, 29, 0.12); }

<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:mhk="MHK.UI" editor-extension-mode="False">
    <!-- One player of a lobby. Code fills the country (hidden when unknown), the device (mem-platform: computer or phone icon, the system as tooltip; hidden when unknown), ping (signal bars chip), the driver portrait (character icon) and kart icon, the name (hover, tap or focus opens the player card) with the score rank (mem-rank, hidden when unranked), the set points and the badges (crown = owner, shield = moderator, check = ready, hourglass = waits for the next race, ballot = voted, robot = AI driver), and classes .mine (You: accent), .waiting (dimmed), .ai (an AI driver of the set: no country, device, ping, rank or kick). mem-kick (room owner, moderators) removes the player. Sample: sample-mine. -->
    <ui:Style src="/Assets/MHK/UI/MHKTheme.uss" />
    <ui:VisualElement class="mem-card">
        <ui:VisualElement class="mem-top">
            <ui:VisualElement class="mem-origin">
                <ui:Label name="mem-country" text="DE" tooltip="Germany" class="mem-country" />
                <ui:VisualElement name="mem-platform" tooltip="macOS" class="icon i-computer mem-platform" />
            </ui:VisualElement>
            <ui:VisualElement name="mem-ping" class="info-chips mem-ping" />
        </ui:VisualElement>
        <ui:VisualElement name="mem-driver" class="mem-driver">
            <mhk:ContentImage name="driver-portrait" class="mem-portrait" image="/Assets/MHK/UI/Samples/character_moorhuhn.png" />
            <mhk:ContentImage name="driver-kart" class="mem-kart" image="/Assets/MHK/UI/Samples/mhk2.kart_icon.png" />
        </ui:VisualElement>
        <ui:VisualElement class="mem-name-row">
            <ui:Label name="mem-name" text="SmokeRacer" class="mem-name" />
            <ui:Label name="mem-rank" text="#12" tooltip="Rank 12 with 840 points" class="player-rank mem-rank" />
        </ui:VisualElement>
        <ui:VisualElement name="mem-badges" class="info-chips mem-badges" />
        <ui:Label name="mem-points" text="27" tooltip="Points in this set" class="mem-points" />
        <ui:Button name="mem-kick" tooltip="Remove from the lobby" class="mhk-button small secondary icon-only mem-kick">
            <ui:VisualElement class="icon i-close" />
        </ui:Button>
    </ui:VisualElement>
</ui:UXML>

<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- One lobby of the selected public category (Online page): a compact button with the lobby number, players / max and the phase. Clicking joins it (disabled while full). -->
    <ui:Style src="/Assets/MHK/UI/MHKTheme.uss" />
    <ui:Button class="mhk-button small secondary onl-instance">
        <ui:Label name="inst-name" text="#1" class="onl-instance-name" />
        <ui:VisualElement name="inst-chips" class="info-chips" />
    </ui:Button>
</ui:UXML>

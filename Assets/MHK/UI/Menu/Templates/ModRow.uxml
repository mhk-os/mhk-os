<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- One installed mod or asset pack row. Code sets mod-logo (or the fallback icon class), the texts, the toggle state (class on or off), the move tooltips and disables mod-up on the first row and mod-down on the last. An item downloaded from a source (GitHub repository) shows its update state (mod-source), the bar while it downloads, Update while an update is available (class src-update on the row) and Remove (class src-managed), src-confirm on the row shows Keep Files and Delete instead of the buttons. -->
    <ui:Style src="/Assets/MHK/UI/MHKTheme.uss" />
    <ui:VisualElement class="mod-row">
        <ui:VisualElement name="mod-logo" class="mod-logo" />
        <ui:VisualElement class="mod-info">
            <ui:Label name="mod-title" text="Moorhuhn Kart" class="mod-title" />
            <ui:Label name="mod-text" text="The base content pack required by the game." class="mod-text" />
            <ui:VisualElement name="mod-status" class="src-status" style="display: none;">
                <ui:VisualElement name="mod-source" class="src-state src-good">
                    <ui:VisualElement class="icon i-cloud_done" />
                    <ui:Label text="Up to date | 4b69b07" class="src-state-label" />
                </ui:VisualElement>
                <ui:VisualElement name="mod-bar" class="src-bar" style="display: none;">
                    <ui:VisualElement class="src-bar-fill" style="width: 40%;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button name="mod-update" class="mhk-button small src-action src-row-update">
            <ui:VisualElement class="icon i-update" />
            <ui:Label text="Update" class="button-label" />
        </ui:Button>
        <ui:Button name="mod-toggle" text="Enabled" class="mhk-button small mod-toggle on" />
        <ui:Button name="mod-up" class="mhk-button small secondary icon-only mod-move">
            <ui:VisualElement class="icon i-arrow_upward" />
        </ui:Button>
        <ui:Button name="mod-down" class="mhk-button small secondary icon-only mod-move">
            <ui:VisualElement class="icon i-arrow_downward" />
        </ui:Button>
        <ui:Button name="mod-remove" tooltip="Remove" class="mhk-button small secondary icon-only mod-move src-remove src-row-remove">
            <ui:VisualElement class="icon i-delete" />
        </ui:Button>
        <ui:Button name="src-keep" tooltip="Stops updates. The files stay installed." class="mhk-button small secondary src-confirm-button">
            <ui:Label text="Keep Files" class="button-label" />
        </ui:Button>
        <ui:Button name="src-delete" tooltip="Stops updates and deletes the installed files." class="mhk-button small src-confirm-button src-delete">
            <ui:VisualElement class="icon i-delete" />
            <ui:Label text="Delete" class="button-label" />
        </ui:Button>
    </ui:VisualElement>
</ui:UXML>

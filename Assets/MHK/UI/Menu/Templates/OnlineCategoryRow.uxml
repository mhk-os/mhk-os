<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- One public lobby category of the Online page. Code sets the name, the packs line, the anticheat tag (cat-anticheat or cat-no-anticheat shows), the players line and .selected (the category the side panel lists) / .alt. lb-main selects the category (its instances show in the side panel), cat-quick joins its fullest instance with room. -->
    <ui:Style src="/Assets/MHK/UI/MHKTheme.uss" />
    <ui:VisualElement class="lb-row">
        <ui:Button name="lb-main" class="lb-main">
            <ui:VisualElement class="lb-who">
                <ui:Label name="cat-name" text="Races: all four games" class="onl-cat-name" />
                <ui:Label name="cat-packs" text="MHK 2 | MHK 3 | MHK Extra | MHK Thunder" class="onl-cat-packs" />
            </ui:VisualElement>
            <ui:VisualElement name="cat-anticheat" tooltip="Players' games check each other's karts; cheaters are removed from the race." class="lb-tag onl-anticheat">
                <ui:VisualElement class="icon i-shield_person" />
                <ui:Label text="Anticheat" class="lb-tag-label" />
            </ui:VisualElement>
            <ui:Label name="cat-no-anticheat" text="No anticheat" tooltip="Nobody checks the karts: anything goes." class="lb-tag onl-no-anticheat" />
            <ui:Label name="cat-players" text="12 racing" class="onl-players" />
        </ui:Button>
        <ui:VisualElement class="row lb-actions">
            <ui:Button name="cat-quick" tooltip="Joins the fullest lobby of this category that has room." class="mhk-button small go">
                <ui:VisualElement class="icon i-bolt" />
                <ui:Label text="Quick join" class="button-label" />
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:mhk="MHK.UI" editor-extension-mode="False">
    <!-- One online run (track records leaderboard and Hidden tab, Reports page, player runs page). Code sets the texts, the driver portrait and kart icon (names as tooltips) and classes: .medal-1 / .medal-2 / .medal-3 on lb-rank (top three), .selected (picked to race: check mark), .mine (the player's own run: highlighted, the You tag), .hidden-run (hidden by a moderator: dimmed, the hidden icon), .flagged (lb-flags with the count, moderators only), .mismatch (lb-mismatch), .alt (every second row). lb-player-rank is the uploader's score rank (hidden when unranked). lb-sub (track and class) shows on the Reports page only (.lb-list-reports on the list). lb-main toggles the pick (Reports page: shows the run's details; player runs: opens the track); hovering or tapping lb-name and lb-profile open the player card; lb-watch downloads and replays. Moderators (.lb-list-mod on the list) also get lb-hide and lb-account. Samples add sample-selected / sample-mine / sample-hidden / sample-flagged / sample-mismatch / sample-gold on their Instance. -->
    <ui:Style src="/Assets/MHK/UI/MHKTheme.uss" />
    <ui:VisualElement class="lb-row">
        <ui:Button name="lb-main" class="lb-main">
            <ui:VisualElement name="lb-check" class="ghost-check lb-check">
                <ui:VisualElement class="icon i-check" />
            </ui:VisualElement>
            <ui:Label name="lb-rank" text="1" class="lb-rank" />
            <ui:VisualElement class="driver-icons lb-driver">
                <mhk:ContentImage name="driver-portrait" tooltip="Moorhuhn" class="driver-icon driver-portrait" image="/Assets/MHK/UI/Samples/character_moorhuhn.png" />
                <mhk:ContentImage name="driver-kart" tooltip="Red Kart" class="driver-icon driver-kart" image="/Assets/MHK/UI/Samples/mhk2.kart_icon.png" />
            </ui:VisualElement>
            <ui:VisualElement class="lb-who">
                <ui:VisualElement class="lb-name-row">
                    <ui:Label name="lb-name" text="SmokeRacer" class="lb-name" />
                    <ui:Label name="lb-player-rank" text="#12" tooltip="Rank 12 with 840 points" class="player-rank lb-player-rank" />
                    <ui:Label name="lb-you" text="You" class="lb-you" />
                    <ui:Label name="lb-country" text="DE" tooltip="Germany" class="lb-country" />
                </ui:VisualElement>
                <ui:Label name="lb-sub" text="Scribble Blocks | 150cc" class="lb-sub" />
            </ui:VisualElement>
            <ui:VisualElement class="lb-badges">
                <ui:VisualElement name="lb-flags" tooltip="Reported by 2 players" class="lb-badge lb-flags">
                    <ui:VisualElement class="icon i-flag" />
                    <ui:Label name="lb-flags-count" text="2" class="lb-badge-label" />
                </ui:VisualElement>
                <ui:VisualElement name="lb-mismatch" tooltip="Kart setup differs from most players&apos;" class="lb-badge lb-mismatch">
                    <ui:VisualElement class="icon i-warning" />
                </ui:VisualElement>
                <ui:VisualElement name="lb-hidden" tooltip="Hidden by a moderator" class="lb-badge lb-hidden">
                    <ui:VisualElement class="icon i-visibility_off" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="lb-times">
                <ui:Label name="lb-time" text="03:21.40" class="lb-time" />
                <ui:VisualElement name="lb-lap-box" tooltip="Best lap" class="lb-lap-box">
                    <ui:VisualElement class="icon i-timer" />
                    <ui:Label name="lb-lap" text="01:05.12" class="lb-lap" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:Button>
        <ui:VisualElement name="lb-actions" class="row lb-actions">
            <ui:Button name="lb-profile" tooltip="Player card" class="mhk-button small secondary icon-only">
                <ui:VisualElement class="icon i-person" />
            </ui:Button>
            <ui:Button name="lb-watch" tooltip="Watch" class="mhk-button small secondary icon-only">
                <ui:VisualElement class="icon i-visibility" />
            </ui:Button>
            <ui:Button name="lb-hide" tooltip="Hide this run" class="mhk-button small secondary icon-only lb-mod-action">
                <ui:VisualElement name="lb-hide-icon" class="icon i-visibility_off" />
            </ui:Button>
            <ui:Button name="lb-account" tooltip="Disable or enable the account" class="mhk-button small secondary icon-only lb-mod-action">
                <ui:VisualElement class="icon i-gavel" />
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

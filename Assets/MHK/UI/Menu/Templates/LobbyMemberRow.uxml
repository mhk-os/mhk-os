<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:mhk="MHK.UI" editor-extension-mode="False">
    <!-- One lobby member. Code sets the country, name, driver | kart line, the driver portrait and kart icon, ping and set points, and classes: .mine (You), .owner, .moderator, .ready (private rooms), .waiting (sits out the running race), .voted (voted this round), .kickable (lob-kick shows: room owner or moderator), .alt. Samples add sample-mine / sample-owner / sample-ready. -->
    <ui:Style src="/Assets/MHK/UI/MHKTheme.uss" />
    <ui:VisualElement class="lb-row">
        <ui:Button name="lb-main" class="lb-main">
            <ui:Label name="lb-country" text="DE" tooltip="Germany" class="lb-country" />
            <ui:VisualElement class="lb-who">
                <ui:VisualElement class="lb-name-row">
                    <ui:Label name="lb-name" text="SmokeRacer" class="lb-name" />
                    <ui:Label text="You" class="lb-tag lb-you" />
                    <ui:Label text="Owner" tooltip="Owns the room: settings, start, kick." class="lb-tag lob-owner" />
                    <ui:Label text="Mod" tooltip="Moderator" class="lb-tag lob-mod" />
                    <ui:Label text="Ready" class="lb-tag lob-ready" />
                    <ui:Label text="Voted" class="lb-tag lob-voted" />
                    <ui:Label text="Waiting" tooltip="Joined during the race: races in the next one." class="lb-tag lob-waiting" />
                </ui:VisualElement>
                <ui:Label name="lb-sub" text="Moorhuhn | Red Kart" class="lb-sub" />
            </ui:VisualElement>
            <ui:VisualElement class="driver-icons lb-driver">
                <mhk:ContentImage name="driver-portrait" tooltip="Moorhuhn" class="driver-icon driver-portrait" image="/Assets/MHK/UI/Samples/character_moorhuhn.png" />
                <mhk:ContentImage name="driver-kart" tooltip="Red Kart" class="driver-icon driver-kart" image="/Assets/MHK/UI/Samples/mhk2.kart_icon.png" />
            </ui:VisualElement>
            <ui:Label name="lob-ping" text="42 ms" tooltip="Round trip time to the server" class="lob-ping" />
            <ui:Label name="lob-points" text="27" tooltip="Points in this set" class="lob-points" />
        </ui:Button>
        <ui:VisualElement class="row lb-actions">
            <ui:Button name="lob-kick" tooltip="Remove this player from the lobby" class="mhk-button small secondary icon-only lob-kick">
                <ui:VisualElement class="icon i-close" />
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- One built-in mod on the first start download screen. Code sets the title, the size, the state (icon, text, colour class, tooltip, hidden while it downloads), the download bar (base-progress: pause or resume button, percent, bar) and base-action: Download, Retry after an error, Installed (disabled) afterwards, hidden while it downloads or is paused. -->
    <ui:Style src="/Assets/MHK/UI/MHKTheme.uss" />
    <ui:VisualElement class="mod-row base-row">
        <ui:VisualElement class="mod-logo mod-logo-fallback src-logo i-extension" />
        <ui:VisualElement class="mod-info">
            <ui:Label name="base-title" text="Moorhuhn Kart 2" class="mod-title" />
            <ui:VisualElement class="src-status">
                <ui:VisualElement name="base-state" class="src-state src-muted" style="display: none;">
                    <ui:VisualElement class="icon i-cloud_download" />
                    <ui:Label text="Not installed" class="src-state-label" />
                </ui:VisualElement>
                <ui:VisualElement name="base-progress" class="src-progress">
                    <ui:Button name="base-pause" tooltip="Pause" class="mhk-button small secondary icon-only src-pause">
                        <ui:VisualElement class="icon i-pause" />
                    </ui:Button>
                    <ui:Label text="40 %" class="src-percent" />
                    <ui:VisualElement class="src-bar">
                        <ui:VisualElement class="src-bar-fill" style="width: 40%;" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="base-size" text="96 MB" class="base-size" />
        <ui:Button name="base-action" class="mhk-button small src-action base-action">
            <ui:VisualElement name="base-action-icon" class="icon i-download" />
            <ui:Label name="base-action-label" text="Download" class="button-label" />
        </ui:Button>
    </ui:VisualElement>
</ui:UXML>

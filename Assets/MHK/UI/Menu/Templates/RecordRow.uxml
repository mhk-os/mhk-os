<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:mhk="MHK.UI" editor-extension-mode="False">
    <!-- One track of the Time Trials hub in the chosen engine class. Code sets the track and game, your best (rec-best-cell: driver portrait and kart icon, time; .empty without one) and the world record of the current version (rec-world-cell: time, players as tooltip; .empty when none or offline), .alt (every second row) and .missing (no loaded mod has the track: the mod icon shows, the tooltip says so). Samples add sample-alt / sample-selected / sample-missing / sample-empty on their Instance. -->
    <ui:Style src="/Assets/MHK/UI/MHKTheme.uss" />
    <ui:VisualElement class="rec-row">
        <ui:VisualElement name="rec-missing" class="icon i-extension rec-missing-icon" />
        <ui:VisualElement class="rec-names">
            <ui:Label name="rec-track" text="Scribble Blocks" class="rec-track" />
            <ui:Label name="rec-game" text="Moorhuhn Kart Extra" class="rec-game" />
        </ui:VisualElement>
        <ui:VisualElement name="rec-best-cell" class="rec-cell rec-best-cell">
            <ui:VisualElement class="driver-icons rec-driver">
                <mhk:ContentImage name="driver-portrait" tooltip="Moorhuhn" class="driver-icon driver-portrait" image="/Assets/MHK/UI/Samples/character_moorhuhn.png" />
                <mhk:ContentImage name="driver-kart" tooltip="Red Kart" class="driver-icon driver-kart" image="/Assets/MHK/UI/Samples/mhk2.kart_icon.png" />
            </ui:VisualElement>
            <ui:Label name="rec-best" text="01:53.46" class="rec-time" />
        </ui:VisualElement>
        <ui:VisualElement name="rec-world-cell" tooltip="12 players" class="rec-cell rec-world-cell">
            <ui:VisualElement class="icon i-public rec-world-icon" />
            <ui:Label name="rec-world" text="01:49.02" class="rec-time" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

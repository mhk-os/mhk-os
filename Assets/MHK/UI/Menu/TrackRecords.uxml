<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:mhk="MHK.UI" editor-extension-mode="False">
    <!-- One track's records, opened from the Records page. Toolbar: the track picture, name and game, the engine class chips (classes), on narrow screens the section chips (sections: Your ghosts / Leaderboard, .narrow on page shows one section at a time) and the pick count with Clear (pick-clear). Local section (local-panel): the track's records from the save (local-records) and its stored ghosts of the class (GhostRow with check, Watch, Upload or the uploaded rank, Export, Delete; local-empty when none). Global section (global-panel): board (dropdown: the board of this version first, the others Archived with their simulation version and date), filters (lb-search player name, lb-scope region dropdown, lb-kart and lb-character dropdowns), the column head, the player's own row pinned (lb-mine, when it is not on the shown page), the page of rows (LeaderRow, lb-list gets .lb-list-mod for moderators) or lb-state (loading, empty, offline with lb-retry), and the pager. status: the last action's result. Footer: Back, Import folder, Reload, Reports (moderators), Race (with the picked ghosts: downloads the missing ones, then driver and kart). Preview classes on page: preview-narrow (sections), preview-state (lb-state instead of the rows), preview-mod (moderator buttons). -->
    <ui:Style src="/Assets/MHK/UI/MHKTheme.uss" />
    <ui:Template name="Chip" src="/Assets/MHK/UI/Menu/Templates/Chip.uxml" />
    <ui:Template name="GhostRow" src="/Assets/MHK/UI/Menu/Templates/GhostRow.uxml" />
    <ui:Template name="LeaderRow" src="/Assets/MHK/UI/Menu/Templates/LeaderRow.uxml" />
    <ui:Template name="SettingRow" src="/Assets/MHK/UI/Menu/Templates/SettingRow.uxml" />
    <ui:VisualElement name="page" class="menu-page">
        <ui:VisualElement class="header anim pop">
            <ui:Label name="title" text="Records" class="page-title" />
        </ui:VisualElement>
        <ui:VisualElement class="page-body">
            <ui:VisualElement name="main" class="page-main wide anim from-left">
                <ui:VisualElement class="trk-browser">
                    <ui:VisualElement class="panel trk-toolbar">
                        <mhk:ContentImage name="track-picture" class="trk-picture" image="/Assets/MHK/UI/Samples/mhke_scribble_blocks_preview.png" />
                        <ui:VisualElement class="trk-heading">
                            <ui:Label name="track-name" text="Scribble Blocks" class="trk-name" />
                            <ui:Label name="track-game" text="Moorhuhn Kart Extra" class="trk-game" />
                        </ui:VisualElement>
                        <ui:VisualElement name="classes" class="tabs trk-classes">
                            <ui:Instance template="Chip">
                                <ui:AttributeOverrides element-name="chip" text="50cc" />
                            </ui:Instance>
                            <ui:Instance template="Chip" class="sample-selected">
                                <ui:AttributeOverrides element-name="chip" text="100cc" />
                            </ui:Instance>
                            <ui:Instance template="Chip">
                                <ui:AttributeOverrides element-name="chip" text="150cc" />
                            </ui:Instance>
                        </ui:VisualElement>
                        <ui:VisualElement name="sections" class="tabs trk-sections">
                            <ui:Instance template="Chip" class="sample-selected">
                                <ui:AttributeOverrides element-name="chip" text="Your ghosts" />
                            </ui:Instance>
                            <ui:Instance template="Chip">
                                <ui:AttributeOverrides element-name="chip" text="Leaderboard" />
                            </ui:Instance>
                        </ui:VisualElement>
                        <ui:VisualElement class="trk-picks">
                            <ui:Label name="pick-count" text="3 of 50 ghosts" class="trk-pick-count" />
                            <ui:Button name="pick-clear" tooltip="Clear the picked ghosts" class="mhk-button small secondary icon-only">
                                <ui:VisualElement class="icon i-close" />
                            </ui:Button>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="trk-columns">
                        <ui:VisualElement name="local-panel" class="panel trk-local">
                            <ui:VisualElement class="trk-section-head">
                                <ui:Label text="Your ghosts" class="trk-section-title" />
                            </ui:VisualElement>
                            <ui:Label name="local-records" text="Best lap 00:30.10 | Best race 01:53.46" class="trk-local-records" />
                            <ui:ScrollView name="ghost-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" class="ghost-scroll trk-scroll">
                                <ui:VisualElement name="ghost-list" class="ghost-list ghost-list-records">
                                    <ui:Instance template="GhostRow" class="sample-selected">
                                        <ui:AttributeOverrides element-name="ghost-time" text="03:21.40" />
                                    </ui:Instance>
                                    <ui:Instance template="GhostRow" class="sample-last sample-uploaded">
                                        <ui:AttributeOverrides element-name="ghost-time" text="03:23.76" />
                                        <ui:AttributeOverrides element-name="driver-portrait" image="/Assets/MHK/UI/Samples/character_hank.png" />
                                    </ui:Instance>
                                </ui:VisualElement>
                            </ui:ScrollView>
                            <ui:Label name="ghost-empty" text="No ghosts of this class yet. Race a time trial to set one." class="ghost-empty" />
                        </ui:VisualElement>
                        <ui:VisualElement name="global-panel" class="panel trk-global">
                            <ui:VisualElement class="trk-section-head">
                                <ui:Label text="Leaderboard" class="trk-section-title" />
                                <ui:Instance template="SettingRow" name="lb-board" class="setting-row setting-dropdown lb-filter lb-board">
                                    <ui:AttributeOverrides element-name="setting-label" text="Board" />
                                    <ui:AttributeOverrides element-name="setting-value-label" text="This version | 12 players" />
                                </ui:Instance>
                            </ui:VisualElement>
                            <ui:VisualElement class="lb-filters">
                                <ui:TextField name="lb-search" max-length="20" class="acc-input lb-search" />
                                <ui:Instance template="SettingRow" name="lb-scope" class="setting-row setting-dropdown lb-filter">
                                    <ui:AttributeOverrides element-name="setting-label" text="Region" />
                                    <ui:AttributeOverrides element-name="setting-value-label" text="World" />
                                </ui:Instance>
                                <ui:Instance template="SettingRow" name="lb-kart" class="setting-row setting-dropdown lb-filter">
                                    <ui:AttributeOverrides element-name="setting-label" text="Kart" />
                                    <ui:AttributeOverrides element-name="setting-value-label" text="Any kart" />
                                </ui:Instance>
                                <ui:Instance template="SettingRow" name="lb-character" class="setting-row setting-dropdown lb-filter">
                                    <ui:AttributeOverrides element-name="setting-label" text="Driver" />
                                    <ui:AttributeOverrides element-name="setting-value-label" text="Any driver" />
                                </ui:Instance>
                            </ui:VisualElement>
                            <ui:VisualElement class="lb-head">
                                <ui:Label text="#" class="lb-head-rank" />
                                <ui:Label text="Player" class="lb-head-who" />
                                <ui:Label text="Time" class="lb-head-time" />
                                <ui:Label text="Best lap" class="lb-head-lap" />
                            </ui:VisualElement>
                            <ui:VisualElement name="lb-mine" class="lb-list lb-mine">
                                <ui:Instance template="LeaderRow" class="sample-mine">
                                    <ui:AttributeOverrides element-name="lb-rank" text="27" />
                                </ui:Instance>
                            </ui:VisualElement>
                            <ui:ScrollView name="lb-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" class="trk-scroll lb-scroll">
                                <ui:VisualElement name="lb-list" class="lb-list">
                                    <ui:Instance template="LeaderRow" class="sample-selected sample-flagged" />
                                    <ui:Instance template="LeaderRow" class="sample-mismatch">
                                        <ui:AttributeOverrides element-name="lb-rank" text="2" />
                                        <ui:AttributeOverrides element-name="lb-name" text="Lesshuhn-Fan" />
                                        <ui:AttributeOverrides element-name="lb-country" text="AT" />
                                        <ui:AttributeOverrides element-name="lb-time" text="03:22.95" />
                                    </ui:Instance>
                                    <ui:Instance template="LeaderRow" class="sample-hidden">
                                        <ui:AttributeOverrides element-name="lb-rank" text="" />
                                        <ui:AttributeOverrides element-name="lb-name" text="Speedy" />
                                        <ui:AttributeOverrides element-name="lb-time" text="00:41.02" />
                                    </ui:Instance>
                                </ui:VisualElement>
                            </ui:ScrollView>
                            <ui:VisualElement name="lb-state" class="lb-state">
                                <ui:VisualElement name="lb-state-icon" class="icon i-cloud_off lb-state-icon" />
                                <ui:Label name="lb-state-label" text="The server can't be reached." class="lb-state-label" />
                                <ui:Button name="lb-retry" class="mhk-button small secondary">
                                    <ui:VisualElement class="icon i-sync" />
                                    <ui:Label text="Retry" class="button-label" />
                                </ui:Button>
                            </ui:VisualElement>
                            <ui:VisualElement name="lb-pager" class="lb-pager">
                                <ui:Button name="lb-prev" tooltip="Previous page" class="mhk-button small secondary icon-only">
                                    <ui:VisualElement class="icon i-chevron_left" />
                                </ui:Button>
                                <ui:Label name="lb-range" text="1-25 of 312" class="lb-range" />
                                <ui:Button name="lb-next" tooltip="Next page" class="mhk-button small secondary icon-only">
                                    <ui:VisualElement class="icon i-chevron_right" />
                                </ui:Button>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label name="status" text="Ghost uploaded: rank 3." class="records-status trk-status" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="footer" class="page-footer anim">
            <ui:VisualElement class="checker-strip" />
            <ui:VisualElement class="footer-left">
                <ui:Button name="back" class="mhk-button small secondary">
                    <ui:VisualElement class="icon i-arrow_back" />
                    <ui:Label text="Back" class="button-label" />
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement class="footer-right">
                <ui:Button name="open-import" class="mhk-button small secondary desktop-only">
                    <ui:VisualElement class="icon i-folder_open" />
                    <ui:Label text="Import folder" class="button-label" />
                </ui:Button>
                <ui:Button name="reload" class="mhk-button small secondary">
                    <ui:VisualElement class="icon i-replay" />
                    <ui:Label text="Reload" class="button-label" />
                </ui:Button>
                <ui:Button name="reports" class="mhk-button small secondary trk-reports">
                    <ui:VisualElement class="icon i-shield_person" />
                    <ui:Label text="Reports" class="button-label" />
                </ui:Button>
                <ui:Button name="race" class="mhk-button go">
                    <ui:VisualElement class="icon i-flag" />
                    <ui:Label name="race-label" text="Race" class="button-label" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- Title screen. Code fills logo (GameConfig.gameLogo, logo-text instead when there is none) and version, shows get-mods while built-in mods are missing and nothing downloads, the dot on mods (notify-dot: class on, red for an update, downloading blue while something downloads), game-update next to the version when a newer game release exists, quit is hidden on mobile (desktop-only) and in WebGL builds. online opens the Online page (which offers the Account page while logged out). achievements (footer, trophy) opens the Achievements page. account (footer) opens the Account page; its label is the online username, or Log in. While a stored login is not online, account gets class connecting (account-icon sync) or offline (account-icon cloud_off, error when the server refused the session) and a tooltip with the reason. -->
    <ui:Style src="/Assets/MHK/UI/MHKTheme.uss" />
    <ui:VisualElement name="page" class="title-page">
        <ui:VisualElement class="title-body">
            <ui:VisualElement class="title-left">
                <ui:VisualElement name="logo-wrap" class="anim pop">
                    <ui:VisualElement name="logo" class="logo bob" usage-hints="DynamicTransform" style="background-image: url(&quot;project://database/Assets/MHK/Branding/GameLogo.png?fileID=2800000&amp;guid=96864abf95ac46318d55c9468c014a2a&amp;type=3#GameLogo&quot;);"/>
                </ui:VisualElement>
                <ui:Label name="logo-text" text="Moorhuhn Kart: Open Source" class="title logo-text anim pop" style="display: none;"/>
                <ui:VisualElement class="panel title-buttons">
                    <ui:Button name="get-mods" tooltip="Opens the Mods page to download the built-in mods with the drivers, karts and tracks." class="mhk-button go anim from-left title-get-mods" style="transition-delay: 140ms; display: none;">
                        <ui:VisualElement class="icon i-download"/>
                        <ui:Label text="Download Mods" class="button-label"/>
                    </ui:Button>
                    <ui:Button name="championship" class="mhk-button big anim from-left" style="transition-delay: 200ms;">
                        <ui:VisualElement class="icon i-emoji_events"/>
                        <ui:Label text="Championship" class="button-label"/>
                    </ui:Button>
                    <ui:Button name="single-race" class="mhk-button anim from-left" style="transition-delay: 260ms;">
                        <ui:VisualElement class="icon i-play_arrow"/>
                        <ui:Label text="Single Race" class="button-label"/>
                    </ui:Button>
                    <ui:Button name="time-trials" tooltip="Race ghosts and climb the leaderboards" class="mhk-button anim from-left" style="transition-delay: 320ms;">
                        <ui:VisualElement class="icon i-timer"/>
                        <ui:Label text="Time Trials" class="button-label"/>
                    </ui:Button>
                    <ui:Button name="battle" class="mhk-button anim from-left" style="transition-delay: 380ms;">
                        <ui:VisualElement class="icon i-swords"/>
                        <ui:Label text="Battle" class="button-label"/>
                    </ui:Button>
                    <ui:Button name="online" tooltip="Race and battle other players" class="mhk-button anim from-left" style="transition-delay: 410ms;">
                        <ui:VisualElement class="icon i-public" />
                        <ui:Label text="Online" class="button-label" />
                    </ui:Button>
                    <ui:VisualElement class="title-small anim from-left" style="transition-delay: 470ms;">
                        <ui:VisualElement class="title-small-row">
                            <ui:Button name="mods" class="mhk-button small secondary">
                                <ui:VisualElement class="icon i-extension"/>
                                <ui:Label text="Mods" class="button-label"/>
                                <ui:VisualElement name="mods-dot" class="notify-dot" picking-mode="Ignore"/>
                            </ui:Button>
                            <ui:Button name="options" class="mhk-button small secondary">
                                <ui:VisualElement class="icon i-settings"/>
                                <ui:Label text="Options" class="button-label"/>
                            </ui:Button>
                        </ui:VisualElement>
                        <ui:VisualElement class="title-small-row">
                            <ui:Button name="music" class="mhk-button small secondary">
                                <ui:VisualElement class="icon i-music_note"/>
                                <ui:Label text="Music" class="button-label"/>
                            </ui:Button>
                            <ui:Button name="quit" class="mhk-button small secondary desktop-only">
                                <ui:VisualElement class="icon i-door_open"/>
                                <ui:Label text="Quit" class="button-label"/>
                            </ui:Button>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="footer" class="page-footer anim" style="transition-delay: 30ms;">
            <ui:VisualElement class="checker-strip"/>
            <ui:VisualElement class="footer-left">
                <ui:Label name="version" text="Build 1" class="muted"/>
                <ui:Button name="game-update" tooltip="Opens the release page of the new game version." class="mhk-button small go title-update" style="display: none;">
                    <ui:VisualElement class="icon i-download"/>
                    <ui:Label text="Update available!" class="button-label"/>
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement class="footer-right">
                <ui:Button name="achievements" tooltip="Achievements" class="mhk-button small secondary icon-only">
                    <ui:VisualElement class="icon i-emoji_events"/>
                </ui:Button>
                <ui:Button name="account" tooltip="Your online account: log in, register, country." class="mhk-button small secondary title-account">
                    <ui:VisualElement name="account-icon" class="icon i-account_circle"/>
                    <ui:Label name="account-label" text="Log in" class="button-label"/>
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

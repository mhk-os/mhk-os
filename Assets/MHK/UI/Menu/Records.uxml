<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:mhk="MHK.UI" editor-extension-mode="False">
    <!-- Records. Code fills rec-list with one row per loaded track and per track of a mod that is not loaded but has a record (.missing). Clicking or submitting a row (or Open) opens that track's records page (ghosts, leaderboard, racing picked ghosts). The side panel shows the focused track (.selected): picture, name, game, the stored ghost count chip (rec-chips), its best ghost per engine class (rec-classes: class chip, driver and kart, time; .empty without one), the Auto-upload toggle (auto-upload, .on) and the account chip (rec-account, .online when logged in: the username, else Log in), and the status line (after an import). Reports (moderators only) opens the flagged runs. Ghosts in the import folder are taken in when the page opens and when the game gets the focus back, Reload does it at once. -->
    <ui:Style src="/Assets/MHK/UI/MHKTheme.uss" />
    <ui:Template name="RecordRow" src="/Assets/MHK/UI/Menu/Templates/RecordRow.uxml" />
    <ui:VisualElement name="page" class="menu-page">
        <ui:VisualElement class="header anim pop">
            <ui:Label name="title" text="Records" class="page-title" />
        </ui:VisualElement>
        <ui:VisualElement class="page-body">
            <ui:VisualElement name="main" class="page-main wide anim from-left">
                <ui:VisualElement class="records-browser">
                    <ui:VisualElement name="records-panel" class="panel list-panel records-panel">
                        <ui:VisualElement class="rec-head">
                            <ui:Label text="Track" class="rec-track" />
                            <ui:Label text="Game" class="rec-game" />
                            <ui:Label text="Best lap" class="rec-cell rec-head-time" />
                            <ui:Label text="Best race" class="rec-cell rec-head-time" />
                        </ui:VisualElement>
                        <ui:ScrollView name="rec-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" class="list-scroll">
                            <ui:VisualElement name="rec-list">
                                <ui:Instance template="RecordRow" class="sample-selected" />
                                <ui:Instance template="RecordRow" class="sample-alt">
                                    <ui:AttributeOverrides element-name="rec-track" text="Kart Track" />
                                    <ui:AttributeOverrides element-name="rec-lap" text="01:01.78" />
                                    <ui:AttributeOverrides element-name="rec-race" text="03:11.31" />
                                    <ui:AttributeOverrides element-name="driver-portrait" image="/Assets/MHK/UI/Samples/character_hank.png" />
                                </ui:Instance>
                                <ui:Instance template="RecordRow">
                                    <ui:AttributeOverrides element-name="rec-track" text="Luna" />
                                    <ui:AttributeOverrides element-name="rec-lap" text="01:15.97" />
                                    <ui:AttributeOverrides element-name="rec-race" text="03:58.56" />
                                    <ui:AttributeOverrides element-name="driver-portrait" image="/Assets/MHK/UI/Samples/character_snowman.png" />
                                </ui:Instance>
                                <ui:Instance template="RecordRow" class="sample-alt sample-empty">
                                    <ui:AttributeOverrides element-name="rec-track" text="Dockland" />
                                    <ui:AttributeOverrides element-name="rec-lap" text="--:--.--" />
                                    <ui:AttributeOverrides element-name="rec-race" text="--:--.--" />
                                </ui:Instance>
                                <ui:Instance template="RecordRow" class="sample-empty">
                                    <ui:AttributeOverrides element-name="rec-track" text="Booo!" />
                                    <ui:AttributeOverrides element-name="rec-lap" text="--:--.--" />
                                    <ui:AttributeOverrides element-name="rec-race" text="--:--.--" />
                                </ui:Instance>
                                <ui:Instance template="RecordRow" class="sample-alt">
                                    <ui:AttributeOverrides element-name="rec-track" text="Island" />
                                    <ui:AttributeOverrides element-name="rec-game" text="Moorhuhn Kart 2" />
                                    <ui:AttributeOverrides element-name="rec-lap" text="01:44.24" />
                                    <ui:AttributeOverrides element-name="rec-race" text="05:48.19" />
                                    <ui:AttributeOverrides element-name="driver-portrait" image="/Assets/MHK/UI/Samples/character_pumpkin.png" />
                                </ui:Instance>
                                <ui:Instance template="RecordRow" class="sample-missing">
                                    <ui:AttributeOverrides element-name="rec-track" text="Warehouse" />
                                    <ui:AttributeOverrides element-name="rec-game" text="TINcan" />
                                    <ui:AttributeOverrides element-name="rec-lap" text="00:54.45" />
                                    <ui:AttributeOverrides element-name="rec-race" text="02:58.70" />
                                </ui:Instance>
                            </ui:VisualElement>
                        </ui:ScrollView>
                    </ui:VisualElement>
                    <ui:VisualElement name="records-side" class="panel records-ghosts records-side">
                        <mhk:ContentImage name="rec-picture" class="rec-picture" image="/Assets/MHK/UI/Samples/mhke_scribble_blocks_preview.png" />
                        <ui:VisualElement class="rec-side-head">
                            <ui:VisualElement class="rec-side-names">
                                <ui:Label name="ghosts-title" text="Scribble Blocks" class="records-ghosts-title" />
                                <ui:Label name="rec-side-game" text="Moorhuhn Kart Extra" class="rec-side-game" />
                            </ui:VisualElement>
                            <ui:VisualElement name="rec-chips" class="info-chips rec-chips" />
                        </ui:VisualElement>
                        <ui:VisualElement name="rec-classes" class="rec-classes" />
                        <ui:VisualElement class="rec-side-actions">
                            <ui:Button name="auto-upload" class="rec-toggle on">
                                <ui:VisualElement name="auto-upload-icon" class="icon i-toggle_on rec-toggle-icon" />
                                <ui:Label name="auto-upload-label" text="Auto-upload" class="rec-toggle-label" />
                            </ui:Button>
                            <ui:Button name="rec-account" class="rec-account-chip">
                                <ui:VisualElement name="rec-account-icon" class="icon i-login rec-account-icon" />
                                <ui:Label name="rec-account-label" text="Log in" class="rec-account-label" />
                            </ui:Button>
                        </ui:VisualElement>
                        <ui:Label name="ghost-status" text="Ghosts imported: 2" class="records-status" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="footer" class="page-footer anim">
            <ui:VisualElement class="checker-strip" />
            <ui:VisualElement class="footer-left">
                <ui:Button name="back" class="mhk-button small secondary">
                    <ui:VisualElement class="icon i-arrow_back" />
                    <ui:Label text="Back" class="button-label" />
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement class="footer-right">
                <ui:Button name="reports" class="mhk-button small secondary trk-reports">
                    <ui:VisualElement class="icon i-shield_person" />
                    <ui:Label text="Reports" class="button-label" />
                </ui:Button>
                <ui:Button name="open-import" tooltip="Import folder" class="mhk-button small secondary icon-only desktop-only">
                    <ui:VisualElement class="icon i-folder_open" />
                </ui:Button>
                <ui:Button name="reload" tooltip="Reload ghosts" class="mhk-button small secondary icon-only">
                    <ui:VisualElement class="icon i-replay" />
                </ui:Button>
                <ui:Button name="open" class="mhk-button go">
                    <ui:VisualElement class="icon i-leaderboard" />
                    <ui:Label text="Open" class="button-label" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

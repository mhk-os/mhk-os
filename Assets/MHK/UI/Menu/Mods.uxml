<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- Mods and asset packs. Code fills the section chips (sections: Mods, Asset Packs) and mod-list with one ModRow per installed mod or asset pack of the chosen section, in load order (top wins), then one SourceRow per source (GitHub repository) of that section that is not installed yet. source-bar adds a source from a pasted link (error line below it) and holds Update All (this section). The section chips get a red dot (notify-dot) while their section has an update. Apply is disabled until something changed since the last load. The sample rows show an enabled entry, sample-off on a row's TemplateContainer previews a disabled one. -->
    <ui:Style src="/Assets/MHK/UI/MHKTheme.uss" />
    <ui:Template name="Chip" src="/Assets/MHK/UI/Menu/Templates/Chip.uxml" />
    <ui:Template name="ModRow" src="/Assets/MHK/UI/Menu/Templates/ModRow.uxml" />
    <ui:Template name="SourceRow" src="/Assets/MHK/UI/Menu/Templates/SourceRow.uxml" />
    <ui:VisualElement name="page" class="menu-page">
        <ui:VisualElement class="header anim pop">
            <ui:Label name="title" text="Mods" class="page-title" />
        </ui:VisualElement>
        <ui:VisualElement class="page-body">
            <ui:VisualElement name="main" class="page-main wide center anim from-left">
                <ui:VisualElement name="mods-panel" class="panel list-panel">
                    <ui:VisualElement name="sections" class="tabs mods-sections">
                        <ui:Instance template="Chip" class="sample-selected">
                            <ui:AttributeOverrides element-name="chip" text="Mods" />
                        </ui:Instance>
                        <ui:Instance template="Chip">
                            <ui:AttributeOverrides element-name="chip" text="Asset Packs" />
                        </ui:Instance>
                    </ui:VisualElement>
                    <ui:VisualElement name="source-bar" class="src-add-bar">
                        <ui:VisualElement class="src-add">
                            <ui:TextField name="source-input" max-length="200" class="src-input" />
                            <ui:Button name="source-paste" tooltip="Paste" class="mhk-button small secondary icon-only src-add-button">
                                <ui:VisualElement class="icon i-content_paste" />
                            </ui:Button>
                            <ui:Button name="source-add" tooltip="Adds the GitHub repository. Its releases are downloaded as a mod or asset pack." class="mhk-button small src-add-button">
                                <ui:VisualElement class="icon i-add" />
                                <ui:Label text="Add" class="button-label" />
                            </ui:Button>
                        </ui:VisualElement>
                        <ui:VisualElement class="src-tools">
                            <ui:VisualElement name="source-error" class="src-error" style="visibility: hidden;">
                                <ui:VisualElement class="icon i-error" />
                                <ui:Label name="source-error-label" text="Not a GitHub repository link." class="src-error-label" />
                            </ui:VisualElement>
                            <ui:Button name="update-all" class="mhk-button small src-tool">
                                <ui:VisualElement class="icon i-update" />
                                <ui:Label text="Update All" class="button-label" />
                            </ui:Button>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:ScrollView name="mod-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" class="list-scroll">
                        <ui:VisualElement name="mod-list">
                            <ui:Instance template="ModRow" />
                            <ui:Instance template="ModRow" class="sample-off">
                                <ui:AttributeOverrides element-name="mod-title" text="TINcan Race | 4b69b07" />
                                <ui:AttributeOverrides element-name="mod-text" text="Adds content from TINcan Race." />
                                <ui:AttributeOverrides element-name="mod-toggle" text="Disabled" />
                            </ui:Instance>
                            <ui:Instance template="SourceRow" />
                        </ui:VisualElement>
                    </ui:ScrollView>
                    <ui:Label name="mod-empty" text="No mods found." class="mods-empty" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="footer" class="page-footer anim">
            <ui:VisualElement class="checker-strip" />
            <ui:VisualElement class="footer-left">
                <ui:Button name="back" class="mhk-button small secondary">
                    <ui:VisualElement class="icon i-arrow_back" />
                    <ui:Label text="Back" class="button-label" />
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement class="footer-right">
                <ui:Button name="open-mods" class="mhk-button small secondary desktop-only">
                    <ui:VisualElement class="icon i-folder_open" />
                    <ui:Label name="open-mods-label" text="Open Mod Folder" class="button-label" />
                </ui:Button>
                <ui:Button name="reload" tooltip="Looks for mods added to the mod folder. Also applies the changes above." class="mhk-button small secondary">
                    <ui:VisualElement class="icon i-replay" />
                    <ui:Label text="Reload" class="button-label" />
                </ui:Button>
                <ui:Button name="apply" class="mhk-button go">
                    <ui:VisualElement class="icon i-check" />
                    <ui:Label text="Apply" class="button-label" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

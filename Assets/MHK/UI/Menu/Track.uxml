<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- Track choice. Code fills title (battles), tabs, card-grid (one picture card per track) and the info panel (hovered or focused card: picture, name, game, laps or arena, records from the save). empty (with the built-in mods download while they are missing) replaces the body when no track is loaded. Preview classes on page: preview-arena (arena line instead of laps), preview-empty. -->
    <ui:Style src="/Assets/MHK/UI/MHKTheme.uss" />
    <ui:Template name="Chip" src="/Assets/MHK/UI/Menu/Templates/Chip.uxml" />
    <ui:Template name="TrackCard" src="/Assets/MHK/UI/Menu/Templates/TrackCard.uxml" />
    <ui:VisualElement name="page" class="menu-page">
        <ui:VisualElement class="header anim pop">
            <ui:Label name="title" text="Choose a track" class="page-title" />
        </ui:VisualElement>
        <ui:VisualElement class="page-body">
            <ui:VisualElement name="main" class="page-main wide anim from-left">
                <ui:VisualElement class="browser">
                    <ui:VisualElement class="browser-list">
                        <ui:VisualElement name="tabs" class="tabs">
                            <ui:Instance template="Chip" class="sample-selected">
                                <ui:AttributeOverrides element-name="chip" text="All" />
                            </ui:Instance>
                            <ui:Instance template="Chip">
                                <ui:AttributeOverrides element-name="chip" text="Moorhuhn Kart Extra" />
                            </ui:Instance>
                            <ui:Instance template="Chip">
                                <ui:AttributeOverrides element-name="chip" text="Moorhuhn Kart 2" />
                            </ui:Instance>
                            <ui:Instance template="Chip">
                                <ui:AttributeOverrides element-name="chip" text="Moorhuhn Kart 3" />
                            </ui:Instance>
                            <ui:Instance template="Chip">
                                <ui:AttributeOverrides element-name="chip" text="Moorhuhn Kart Thunder" />
                            </ui:Instance>
                        </ui:VisualElement>
                        <ui:ScrollView name="card-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" class="list-scroll">
                            <ui:VisualElement name="card-grid" class="card-grid">
                                <ui:Instance template="TrackCard">
                                    <ui:AttributeOverrides element-name="card-title" text="Scribble Blocks" />
                                    <ui:AttributeOverrides element-name="card-tag" text="Moorhuhn Kart Extra" />
                                </ui:Instance>
                                <ui:Instance template="TrackCard">
                                    <ui:AttributeOverrides element-name="card-title" text="Kart Track" />
                                    <ui:AttributeOverrides element-name="card-image" image="/Assets/MHK/UI/Samples/mhke_kart_track_preview.png" />
                                    <ui:AttributeOverrides element-name="card-tag" text="Moorhuhn Kart Extra" />
                                </ui:Instance>
                                <ui:Instance template="TrackCard">
                                    <ui:AttributeOverrides element-name="card-title" text="Luna" />
                                    <ui:AttributeOverrides element-name="card-image" image="/Assets/MHK/UI/Samples/mhke_moon_preview.png" />
                                    <ui:AttributeOverrides element-name="card-tag" text="Moorhuhn Kart Extra" />
                                </ui:Instance>
                                <ui:Instance template="TrackCard">
                                    <ui:AttributeOverrides element-name="card-title" text="Dockland" />
                                    <ui:AttributeOverrides element-name="card-image" image="/Assets/MHK/UI/Samples/mhke_docklands_preview.png" />
                                    <ui:AttributeOverrides element-name="card-tag" text="Moorhuhn Kart Extra" />
                                </ui:Instance>
                                <ui:Instance template="TrackCard">
                                    <ui:AttributeOverrides element-name="card-title" text="Booo!" />
                                    <ui:AttributeOverrides element-name="card-image" image="/Assets/MHK/UI/Samples/mhke_graveyard_preview.png" />
                                    <ui:AttributeOverrides element-name="card-tag" text="Moorhuhn Kart Extra" />
                                </ui:Instance>
                                <ui:Instance template="TrackCard">
                                    <ui:AttributeOverrides element-name="card-title" text="Outdoor" />
                                    <ui:AttributeOverrides element-name="card-image" image="/Assets/MHK/UI/Samples/mhke_outdoor_preview.png" />
                                    <ui:AttributeOverrides element-name="card-tag" text="Moorhuhn Kart Extra" />
                                </ui:Instance>
                                <ui:Instance template="TrackCard">
                                    <ui:AttributeOverrides element-name="card-title" text="Desert" />
                                    <ui:AttributeOverrides element-name="card-image" image="/Assets/MHK/UI/Samples/mhke_desert_preview.png" />
                                    <ui:AttributeOverrides element-name="card-tag" text="Moorhuhn Kart Extra" />
                                </ui:Instance>
                                <ui:Instance template="TrackCard">
                                    <ui:AttributeOverrides element-name="card-title" text="Canyon" />
                                    <ui:AttributeOverrides element-name="card-image" image="/Assets/MHK/UI/Samples/mhke_canyon_preview.png" />
                                    <ui:AttributeOverrides element-name="card-tag" text="Moorhuhn Kart Extra" />
                                </ui:Instance>
                                <ui:Instance template="TrackCard">
                                    <ui:AttributeOverrides element-name="card-title" text="Ice" />
                                    <ui:AttributeOverrides element-name="card-image" image="/Assets/MHK/UI/Samples/mhke_ice_preview.png" />
                                    <ui:AttributeOverrides element-name="card-tag" text="Moorhuhn Kart Extra" />
                                </ui:Instance>
                                <ui:Instance template="TrackCard">
                                    <ui:AttributeOverrides element-name="card-title" text="Volcano" />
                                    <ui:AttributeOverrides element-name="card-image" image="/Assets/MHK/UI/Samples/mhke_volcano_preview.png" />
                                    <ui:AttributeOverrides element-name="card-tag" text="Moorhuhn Kart Extra" />
                                </ui:Instance>
                                <ui:Instance template="TrackCard">
                                    <ui:AttributeOverrides element-name="card-title" text="Moorhuhn X" />
                                    <ui:AttributeOverrides element-name="card-image" image="/Assets/MHK/UI/Samples/mhk2_moorhuhn_x_preview.png" />
                                    <ui:AttributeOverrides element-name="card-tag" text="Moorhuhn Kart 2" />
                                </ui:Instance>
                                <ui:Instance template="TrackCard">
                                    <ui:AttributeOverrides element-name="card-title" text="Winter" />
                                    <ui:AttributeOverrides element-name="card-image" image="/Assets/MHK/UI/Samples/mhk2_winter_preview.png" />
                                    <ui:AttributeOverrides element-name="card-tag" text="Moorhuhn Kart 2" />
                                </ui:Instance>
                            </ui:VisualElement>
                        </ui:ScrollView>
                    </ui:VisualElement>
                    <ui:VisualElement name="info-panel" class="panel browser-preview">
                        <ui:VisualElement name="info-image" class="browser-image" style="background-image: url(&quot;/Assets/MHK/UI/Samples/mhke_scribble_blocks_preview.png&quot;);" />
                        <ui:Label name="info-name" text="Scribble Blocks" class="browser-name" />
                        <ui:Label name="info-game" text="Moorhuhn Kart Extra" class="info-game" />
                        <ui:VisualElement class="fact-list">
                            <ui:VisualElement name="info-arena" class="fact-row">
                                <ui:VisualElement class="icon i-swords" />
                                <ui:Label text="Arena" class="fact-caption" />
                                <ui:Label text="Battles only" class="fact-value" />
                            </ui:VisualElement>
                            <ui:VisualElement name="info-laps" class="fact-row">
                                <ui:VisualElement class="icon i-flag" />
                                <ui:Label text="Length" class="fact-caption" />
                                <ui:Label name="info-laps-text" text="3 laps" class="fact-value" />
                            </ui:VisualElement>
                            <ui:VisualElement class="fact-row">
                                <ui:VisualElement class="icon i-timer" />
                                <ui:Label text="Best lap" class="fact-caption" />
                                <ui:Label name="info-best-lap" text="00:30.10 | Death" class="fact-value" />
                            </ui:VisualElement>
                            <ui:VisualElement class="fact-row">
                                <ui:VisualElement class="icon i-emoji_events" />
                                <ui:Label text="Best race" class="fact-caption" />
                                <ui:Label name="info-best-race" text="01:53.46 | Death" class="fact-value" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="empty" class="select-empty">
                <ui:Label name="empty-text" text="No tracks available." class="panel select-empty-text" />
                <ui:Button name="empty-download" tooltip="Opens the Mods page to download the built-in mods with the drivers, karts and tracks." class="mhk-button go select-empty-download">
                    <ui:VisualElement class="icon i-download" />
                    <ui:Label text="Download Mods" class="button-label" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="footer" class="page-footer anim">
            <ui:VisualElement class="checker-strip" />
            <ui:VisualElement class="footer-left">
                <ui:Button name="back" class="mhk-button small secondary">
                    <ui:VisualElement class="icon i-arrow_back" />
                    <ui:Label text="Back" class="button-label" />
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement class="footer-right" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- Online account. Logged out (signed-out): the mode chips (modes: Log in, Register), username, password and, when registering, confirm (confirm-block) and the rules line; submit sends (Enter too) and shows busy while it waits. Logged in (signed-in): the username, the moderator badge (role 1), the member-since line, the score rank line (account-rank), the country row (dropdown: Auto from the IP, then every country), the players list switch (listed: On / Off), Your profile (profile: the Players page on the own row), Change username (rename: a text prompt for the new name, refused names come back with the reason), Log out and the red Delete account (delete). delete opens delete-box in place of the rows and buttons (class deleting on signed-in): the password (delete-password, Enter confirms), the runs switch (delete-runs: Off keeps the time trial runs as Anonymous, On hides them too), delete-status with the server's error, Cancel (delete-cancel, Back too) and delete-confirm. form-status shows the last error or result (class good for a success). The connection line (connection-icon, class online on connection-bar while connected) names the server and its state; server-toggle opens server-box: the server address field (placeholder = built-in server, empty = built-in), server-apply saves it and reconnects, server-note says when the command line overrides it. achievements (footer) opens the Achievements page; reconnect (footer) connects again while offline. Preview classes on page: preview-signed-in (the logged-in view), preview-register (register mode), preview-status (the status line), preview-server (server box open), preview-offline (Reconnect), preview-delete (with preview-signed-in: the delete box open). -->
    <ui:Style src="/Assets/MHK/UI/MHKTheme.uss" />
    <ui:Template name="Chip" src="/Assets/MHK/UI/Menu/Templates/Chip.uxml" />
    <ui:Template name="SettingRow" src="/Assets/MHK/UI/Menu/Templates/SettingRow.uxml" />
    <ui:VisualElement name="page" class="menu-page">
        <ui:VisualElement class="header anim pop">
            <ui:Label name="title" text="Account" class="page-title" />
        </ui:VisualElement>
        <ui:VisualElement class="page-body">
            <ui:VisualElement name="main" class="page-main wide center anim from-left">
                <ui:VisualElement name="account-panel" class="panel account-panel">
                    <ui:VisualElement name="signed-out" class="acc-signed-out">
                        <ui:VisualElement name="modes" class="tabs acc-modes">
                            <ui:Instance template="Chip" class="sample-selected">
                                <ui:AttributeOverrides element-name="chip" text="Log in" />
                            </ui:Instance>
                            <ui:Instance template="Chip">
                                <ui:AttributeOverrides element-name="chip" text="Register" />
                            </ui:Instance>
                        </ui:VisualElement>
                        <ui:Label text="Username" class="acc-field-label" />
                        <ui:TextField name="username" max-length="20" class="acc-input" />
                        <ui:Label text="Password" class="acc-field-label" />
                        <ui:TextField name="password" password="true" max-length="128" class="acc-input" />
                        <ui:VisualElement name="confirm-block" class="acc-confirm">
                            <ui:Label text="Confirm password" class="acc-field-label" />
                            <ui:TextField name="confirm" password="true" max-length="128" class="acc-input" />
                            <ui:Label name="rules" text="Username: 3 to 20 letters, digits, _ . - (starting and ending with a letter or digit). Password: at least 8 characters. There is no e-mail and no password reset, so keep your password safe." class="acc-rules" />
                        </ui:VisualElement>
                        <ui:Button name="submit" class="mhk-button go acc-submit">
                            <ui:VisualElement name="submit-icon" class="icon i-login" />
                            <ui:Label name="submit-label" text="Log in" class="button-label" />
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement name="signed-in" class="acc-signed-in">
                        <ui:VisualElement class="acc-identity">
                            <ui:VisualElement class="icon i-account_circle acc-avatar" />
                            <ui:VisualElement class="acc-identity-text">
                                <ui:VisualElement class="acc-name-row">
                                    <ui:Label name="account-name" text="Hank" class="acc-name" />
                                    <ui:VisualElement name="moderator-badge" tooltip="Moderators keep online races fair." class="acc-badge">
                                        <ui:VisualElement class="icon i-shield_person" />
                                        <ui:Label text="Moderator" class="acc-badge-label" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:Label name="account-since" text="Racing online since 26 October 2026" class="acc-since" />
                                <ui:Label name="account-rank" text="Rank #12 with 840 points" class="acc-since acc-rank" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Instance template="SettingRow" name="country" class="setting-row setting-dropdown acc-country">
                            <ui:AttributeOverrides element-name="setting-label" text="Country" />
                            <ui:AttributeOverrides element-name="setting-value-label" text="Auto (from IP: DE)" />
                        </ui:Instance>
                        <ui:Instance template="SettingRow" name="listed" tooltip="Others find you on the Players page. Your name still shows in lobbies and on leaderboards." class="setting-row acc-country">
                            <ui:AttributeOverrides element-name="setting-label" text="Show me in the players list" />
                            <ui:AttributeOverrides element-name="setting-value-label" text="On" />
                        </ui:Instance>
                        <ui:Button name="profile" class="mhk-button secondary acc-logout">
                            <ui:VisualElement class="icon i-person" />
                            <ui:Label text="Your profile" class="button-label" />
                        </ui:Button>
                        <ui:Button name="rename" class="mhk-button secondary acc-logout">
                            <ui:VisualElement class="icon i-edit" />
                            <ui:Label text="Change username" class="button-label" />
                        </ui:Button>
                        <ui:Button name="logout" class="mhk-button secondary acc-logout">
                            <ui:VisualElement class="icon i-logout" />
                            <ui:Label text="Log out" class="button-label" />
                        </ui:Button>
                        <ui:Button name="delete" class="mhk-button danger acc-delete">
                            <ui:VisualElement class="icon i-delete" />
                            <ui:Label text="Delete account" class="button-label" />
                        </ui:Button>
                        <ui:VisualElement name="delete-box" class="acc-delete-box">
                            <ui:Label text="Delete your account?" class="acc-delete-title" />
                            <ui:Label text="Your account, its score, achievements and votes are deleted for good. Enter your password to confirm." class="acc-delete-text" />
                            <ui:TextField name="delete-password" password="true" max-length="128" class="acc-input" />
                            <ui:Instance template="SettingRow" name="delete-runs" class="setting-row acc-delete-runs">
                                <ui:AttributeOverrides element-name="setting-label" text="Also delete my time trial runs" />
                                <ui:AttributeOverrides element-name="setting-value-label" text="Off" />
                            </ui:Instance>
                            <ui:Label name="delete-runs-note" text="Otherwise they stay on the leaderboards as Anonymous." class="acc-delete-text" />
                            <ui:VisualElement name="delete-status" class="acc-status">
                                <ui:VisualElement class="icon i-error" />
                                <ui:Label name="delete-status-label" text="Wrong password." class="acc-status-label" />
                            </ui:VisualElement>
                            <ui:VisualElement class="acc-delete-buttons">
                                <ui:Button name="delete-cancel" class="mhk-button small secondary">
                                    <ui:Label text="Cancel" class="button-label" />
                                </ui:Button>
                                <ui:Button name="delete-confirm" class="mhk-button small danger">
                                    <ui:VisualElement class="icon i-delete" />
                                    <ui:Label name="delete-confirm-label" text="Delete forever" class="button-label" />
                                </ui:Button>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="form-status" class="acc-status">
                        <ui:VisualElement name="form-status-icon" class="icon i-error" />
                        <ui:Label name="form-status-label" text="Wrong username or password." class="acc-status-label" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="connection-bar" class="panel acc-connection">
                    <ui:VisualElement class="acc-connection-row">
                        <ui:VisualElement name="connection-icon" class="icon i-cloud_off acc-connection-icon" />
                        <ui:Label name="connection-label" text="Offline: No server is running there (connection refused). Retrying in 4 s." class="acc-connection-label" />
                        <ui:Button name="server-toggle" tooltip="Choose another game server (advanced)." class="mhk-button small secondary icon-only acc-server-toggle">
                            <ui:VisualElement class="icon i-dns" />
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement name="server-box" class="acc-server">
                        <ui:VisualElement class="acc-server-row">
                            <ui:TextField name="server" max-length="200" class="acc-input acc-server-input" />
                            <ui:Button name="server-apply" tooltip="Saves the server address and connects to it. Empty uses the built-in server." class="mhk-button small acc-server-apply">
                                <ui:VisualElement class="icon i-check" />
                                <ui:Label text="Use" class="button-label" />
                            </ui:Button>
                        </ui:VisualElement>
                        <ui:Label name="server-note" text="tls://host:port, or tcp://host:port on this computer or the local network. Empty uses the built-in server." class="acc-server-note" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="footer" class="page-footer anim">
            <ui:VisualElement class="checker-strip" />
            <ui:VisualElement class="footer-left">
                <ui:Button name="back" class="mhk-button small secondary">
                    <ui:VisualElement class="icon i-arrow_back" />
                    <ui:Label text="Back" class="button-label" />
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement class="footer-right">
                <ui:Button name="achievements" class="mhk-button small secondary">
                    <ui:VisualElement class="icon i-emoji_events" />
                    <ui:Label text="Achievements" class="button-label" />
                </ui:Button>
                <ui:Button name="reconnect" class="mhk-button small secondary acc-reconnect">
                    <ui:VisualElement class="icon i-sync" />
                    <ui:Label text="Reconnect" class="button-label" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- Ghost picker (time trial, after the kart). Code fills the track name, the engine class chips (classes), ghost-list (one GhostRow per stored ghost of the track and class plus the leaderboard downloads picked on the track records page, fastest first; the personal best picked, or exactly the ghosts picked on the track records page; picked rows get .selected) and the count. Preview class on page: preview-empty (no ghosts for the class: the centred empty line instead of the list). -->
    <ui:Style src="/Assets/MHK/UI/MHKTheme.uss" />
    <ui:Template name="Chip" src="/Assets/MHK/UI/Menu/Templates/Chip.uxml" />
    <ui:Template name="GhostRow" src="/Assets/MHK/UI/Menu/Templates/GhostRow.uxml" />
    <ui:VisualElement name="page" class="menu-page">
        <ui:VisualElement class="header anim pop">
            <ui:Label name="title" text="Choose ghosts" class="page-title" />
        </ui:VisualElement>
        <ui:VisualElement class="page-body">
            <ui:VisualElement name="main" class="page-main wide center anim from-left">
                <ui:VisualElement name="ghosts-panel" class="panel list-panel ghosts-panel">
                    <ui:VisualElement class="row ghost-toolbar">
                        <ui:Label name="ghost-track" text="Island" class="ghost-toolbar-label" />
                        <ui:VisualElement name="classes" class="tabs ghost-classes">
                            <ui:Instance template="Chip">
                                <ui:AttributeOverrides element-name="chip" text="50cc" />
                            </ui:Instance>
                            <ui:Instance template="Chip" class="sample-selected">
                                <ui:AttributeOverrides element-name="chip" text="100cc" />
                            </ui:Instance>
                            <ui:Instance template="Chip">
                                <ui:AttributeOverrides element-name="chip" text="150cc" />
                            </ui:Instance>
                        </ui:VisualElement>
                        <ui:Label name="ghost-count" text="2 of 3 ghosts" class="ghost-count" />
                    </ui:VisualElement>
                    <ui:ScrollView name="ghost-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" class="ghost-scroll">
                        <ui:VisualElement name="ghost-list" class="ghost-list">
                            <ui:Instance template="GhostRow" class="sample-other sample-imported">
                                <ui:AttributeOverrides element-name="ghost-time" text="03:19.02" />
                                <ui:AttributeOverrides element-name="ghost-player" text="Lesshuhn-Fan" />
                                <ui:AttributeOverrides element-name="ghost-date" text="10/02/2026" />
                                <ui:AttributeOverrides element-name="ghost-class" text="100cc" />
                                <ui:AttributeOverrides element-name="driver-portrait" image="/Assets/MHK/UI/Samples/character_lesshuhn.png" />
                            </ui:Instance>
                            <ui:Instance template="GhostRow" class="sample-selected">
                                <ui:AttributeOverrides element-name="ghost-time" text="03:21.40" />
                                <ui:AttributeOverrides element-name="ghost-class" text="100cc" />
                            </ui:Instance>
                            <ui:Instance template="GhostRow" class="sample-last">
                                <ui:AttributeOverrides element-name="ghost-time" text="03:23.76" />
                                <ui:AttributeOverrides element-name="ghost-class" text="100cc" />
                                <ui:AttributeOverrides element-name="driver-portrait" image="/Assets/MHK/UI/Samples/character_hank.png" />
                            </ui:Instance>
                        </ui:VisualElement>
                    </ui:ScrollView>
                    <ui:Label name="ghost-empty" text="No ghosts for this class yet." class="ghost-empty" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="footer" class="page-footer anim">
            <ui:VisualElement class="checker-strip" />
            <ui:VisualElement class="footer-left">
                <ui:Button name="back" class="mhk-button small secondary">
                    <ui:VisualElement class="icon i-arrow_back" />
                    <ui:Label text="Back" class="button-label" />
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement class="footer-right">
                <ui:Button name="race" class="mhk-button go">
                    <ui:VisualElement class="icon i-flag" />
                    <ui:Label text="Race" class="button-label" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

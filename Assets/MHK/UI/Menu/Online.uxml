<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- Online play. Logged out (class onl-logged-out on page): onl-login with Log in (the Account page). Logged in: mode-tabs (Races / Battles) and anticheat-tabs (with / without) choose the public categories; set-grid holds one card per mod set (Templates/OnlineSetCard.uxml, clicking it is Quick join), inst-list the lobbies of the selected set (Templates/OnlineInstanceRow.uxml). The side panel joins a private room by code (code field, join-code) and creates one (create). onl-status shows content warnings and errors (class good for progress). -->
    <ui:Style src="/Assets/MHK/UI/MHKTheme.uss" />
    <ui:Template name="OnlineSetCard" src="/Assets/MHK/UI/Menu/Templates/OnlineSetCard.uxml" />
    <ui:Template name="OnlineInstanceRow" src="/Assets/MHK/UI/Menu/Templates/OnlineInstanceRow.uxml" />
    <ui:VisualElement name="page" class="menu-page">
        <ui:VisualElement class="header anim pop">
            <ui:Label name="title" text="Online" class="page-title" />
        </ui:VisualElement>
        <ui:VisualElement class="page-body">
            <ui:VisualElement name="main" class="page-main wide anim from-left">
                <ui:VisualElement name="onl-login" class="panel onl-login">
                    <ui:VisualElement class="icon i-cloud_off lb-state-icon" />
                    <ui:Label name="onl-login-label" text="Log in to race online." class="onl-login-label" />
                    <ui:Button name="login" class="mhk-button go">
                        <ui:VisualElement class="icon i-login" />
                        <ui:Label text="Log in" class="button-label" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement name="onl-browser" class="onl-browser">
                    <ui:VisualElement name="public" class="panel onl-public">
                        <ui:VisualElement class="onl-bar">
                            <ui:VisualElement name="mode-tabs" class="tabs onl-tabs">
                                <ui:Button text="Races" class="chip selected" />
                                <ui:Button text="Battles" class="chip" />
                            </ui:VisualElement>
                            <ui:VisualElement name="anticheat-tabs" class="tabs onl-tabs">
                                <ui:Button text="Anticheat" class="chip selected" />
                                <ui:Button text="Off" class="chip" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="set-grid" class="card-grid onl-set-grid">
                            <ui:Instance template="OnlineSetCard" class="sample-selected" />
                            <ui:Instance template="OnlineSetCard">
                                <ui:AttributeOverrides element-name="set-name" text="MHK + TINcan" />
                            </ui:Instance>
                            <ui:Instance template="OnlineSetCard">
                                <ui:AttributeOverrides element-name="set-name" text="MHK 2" />
                            </ui:Instance>
                        </ui:VisualElement>
                        <ui:VisualElement class="onl-lobbies">
                            <ui:VisualElement class="icon i-group onl-lobbies-icon" />
                            <ui:VisualElement name="inst-list" class="onl-inst-list">
                                <ui:Instance template="OnlineInstanceRow" />
                                <ui:Instance template="OnlineInstanceRow">
                                    <ui:AttributeOverrides element-name="inst-name" text="#2" />
                                </ui:Instance>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="onl-status" class="onl-status">
                            <ui:VisualElement name="onl-status-icon" class="icon i-warning" />
                            <ui:Label name="onl-status-label" text="Your copy of tincan differs from other players'." class="onl-status-label" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="side" class="panel onl-side">
                        <ui:VisualElement class="onl-side-head">
                            <ui:VisualElement class="icon i-lock onl-side-icon" />
                            <ui:Label text="Private room" class="onl-side-title" />
                        </ui:VisualElement>
                        <ui:VisualElement class="onl-code-row">
                            <ui:VisualElement class="icon i-pin onl-code-icon" />
                            <ui:TextField name="code" max-length="8" tooltip="The 6-character code of a friend's room." class="acc-input onl-code" />
                            <ui:Button name="join-code" tooltip="Join the room with this code" class="mhk-button go onl-code-join">
                                <ui:VisualElement class="icon i-login" />
                                <ui:Label text="Join" class="button-label" />
                            </ui:Button>
                        </ui:VisualElement>
                        <ui:VisualElement class="onl-or">
                            <ui:VisualElement class="onl-or-line" />
                            <ui:Label text="or" class="onl-or-label" />
                            <ui:VisualElement class="onl-or-line" />
                        </ui:VisualElement>
                        <ui:Button name="create" tooltip="Your own room: choose the mods and rules, invite friends with a code or link." class="mhk-button big onl-create">
                            <ui:VisualElement class="icon i-add" />
                            <ui:Label text="Create room" class="button-label" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="footer" class="page-footer anim">
            <ui:VisualElement class="checker-strip" />
            <ui:VisualElement class="footer-left">
                <ui:Button name="back" class="mhk-button small secondary">
                    <ui:VisualElement class="icon i-arrow_back" />
                    <ui:Label text="Back" class="button-label" />
                </ui:Button>
                <ui:Button name="account" class="mhk-button small secondary">
                    <ui:VisualElement class="icon i-account_circle" />
                    <ui:Label name="account-label" text="SmokeRacer" class="button-label" />
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement class="footer-right">
                <ui:Button name="refresh" tooltip="Refresh the lobbies" class="mhk-button small secondary icon-only">
                    <ui:VisualElement class="icon i-sync" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

/* Moorhuhn Kart: Open Source Edition, UI design system (tokens and shared components). Neutral theme: gray frosted
 * glass plates with dark text, one accent (amber) only for state (focus, selected, warnings). Text over the 3D scene
 * (page titles, HUD, logo) is white with a charcoal outline and drop shadow instead of a plate. The dark .ribbon plate is
 * only for HUD banners and the loading screen. Hovered or focused elements with a tooltip show it in .mhk-tooltip (UiTooltips).
 * Screen layouts live in MHKMenu.uss, the loading screen in MHKLoading.uss and the race HUD in MHKHud.uss. They are
 * imported before the rules below, so their overrides of theme classes use compound selectors to win a tie.
 * Art: Textures/ (generated by mhk-work/tools/gen_ui.py, the mui_* card and page art by gen_menu_ui.py, drawn at 2x so
 * 9-slices use -unity-slice-scale 0.5), Icons/ (Material Symbols Rounded, Apache 2.0: white, used as
 * class="icon i-<name>" and tinted with -unity-background-image-tint-color, one .i-<name> rule per icon file),
 * Fonts/ (Lilita One for titles and HUD numbers, Fredoka for everything else, SIL OFL 1.1). */
@import url("MHKMenu.uss");
@import url("MHKLoading.uss");
@import url("MHKHud.uss");

:root {
    --mhk-white: #FFFFFF;
    --mhk-gray-50: #F5F6F8;
    --mhk-gray-100: #EAECEF;
    --mhk-gray-200: #CDD1D6;
    --mhk-gray-300: #B3B9C1;
    --mhk-gray-400: #8D949E;
    --mhk-gray-500: #6B727C;
    --mhk-gray-600: #50565F;
    --mhk-gray-700: #3A3F46;
    --mhk-gray-800: #272B31;
    --mhk-gray-900: #17191D;
    --mhk-accent: #FFB400;
    --mhk-accent-deep: #C98A00;
    --mhk-accent-soft: rgba(255, 180, 0, 0.22);
    --mhk-bronze: #D39A6A;
    --mhk-good: #4ADE80;
    --mhk-good-ink: #18794E;
    --mhk-bad: #FF6B61;
    --mhk-bad-ink: #C2362C;
    --mhk-row: rgba(23, 25, 29, 0.05);
    --mhk-row-hover: rgba(23, 25, 29, 0.09);
    --mhk-divider: rgba(23, 25, 29, 0.12);
    --mhk-glass: rgba(23, 25, 29, 0.78);
    --mhk-scrim: rgba(23, 25, 29, 0.55);
    --mhk-glass-fill: rgb(222, 225, 230);
    --mhk-glass-show: rgba(255, 255, 255, 0.5);
    --mhk-glass-lite-fill: rgba(222, 225, 230, 0.93);
    --mhk-glass-rim: rgba(255, 255, 255, 0.45);
    --mhk-glass-rim-top: rgba(255, 255, 255, 0.8);
    --mhk-glass-dark-fill: rgb(30, 33, 38);
    --mhk-glass-dark-show: rgba(255, 255, 255, 0.3);
    --mhk-glass-dark-lite-fill: rgba(30, 33, 38, 0.92);
    --mhk-glass-dark-rim: rgba(255, 255, 255, 0.18);
    --mhk-footer-fill: rgb(236, 237, 242);
    --mhk-footer-show: rgba(255, 255, 255, 0.3);
    --mhk-footer-lite-fill: rgba(236, 237, 242, 0.97);
    --mhk-white-70: rgba(255, 255, 255, 0.7);
    --mhk-white-85: rgba(255, 255, 255, 0.85);
    --mhk-outline: rgba(23, 25, 29, 0.92);
    --mhk-shadow: rgba(0, 0, 0, 0.55);
    --font-display: url("Fonts/LilitaOne-Regular SDF.asset");
    --font-body: url("Fonts/Fredoka-SemiBold SDF.asset");
    --font-bold: url("Fonts/Fredoka-Bold SDF.asset");

    -unity-font-definition: var(--font-body);
    font-size: 22px;
    color: var(--mhk-gray-900);
}

.title {
    -unity-font-definition: var(--font-display);
    font-size: 64px;
    color: var(--mhk-white);
    -unity-text-outline: 3px var(--mhk-outline);
    text-shadow: 0 4px 6px var(--mhk-shadow);
    -unity-text-align: middle-center;
    letter-spacing: 1px;
    margin-bottom: 6px;
}

.muted { color: var(--mhk-gray-500); }
.accent { color: var(--mhk-gray-900); -unity-font-definition: var(--font-bold); }

.screen {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    padding: 24px;
}
.row { flex-direction: row; align-items: center; }

/* Entry animation. Elements with .anim are laid out in their final state (UI Builder and the edit-mode Game view
 * show them). When a screen opens, Ui.PlayEntry adds .enter (the start state below) and removes it a frame later,
 * so they slide or pop in. Direction: .from-left, .from-right, .pop (default: from below).
 * Delay: transition-delay on the element (inline, or the page part rules in MHKMenu.uss). */
.anim {
    transition-property: opacity, translate, scale;
    transition-duration: 0.28s, 0.36s, 0.36s;
    transition-timing-function: ease-out, ease-out-cubic, ease-out-cubic;
}
.anim.enter { opacity: 0; translate: 0 20px; }
.anim.enter.from-left { translate: -40px 0; }
.anim.enter.from-right { translate: 40px 0; }
.anim.enter.pop { scale: 0.92 0.92; translate: 0 0; }

/* Glass: gray frosted plates (.panel, .page-footer). UiGlass gives each plate the slice of UiGlassBlur's blurred camera
 * picture behind it as background image, lined up with the screen. The image tint's alpha (--mhk-*-show) is how much
 * of the picture shows through the opaque fill, so dark text stays readable on snow and in tunnels. With .glass-lite on
 * the screen root (mobile below the High preset) there is no picture and the fill itself turns slightly see-through. */
.panel {
    background-color: var(--mhk-glass-fill);
    -unity-background-image-tint-color: var(--mhk-glass-show);
    border-radius: 18px;
    border-width: 1px;
    border-color: var(--mhk-glass-rim);
    border-top-color: var(--mhk-glass-rim-top);
    padding: 20px 24px 24px 24px;
}
.panel.dark { background-color: var(--mhk-glass-dark-fill); -unity-background-image-tint-color: var(--mhk-glass-dark-show); border-color: var(--mhk-glass-dark-rim); color: var(--mhk-white); }
.glass-lite .panel { background-color: var(--mhk-glass-lite-fill); }
.glass-lite .panel.dark { background-color: var(--mhk-glass-dark-lite-fill); }

.mhk-button {
    background-image: url("Textures/button_light.png");
    background-color: transparent;
    -unity-slice-left: 36; -unity-slice-right: 36; -unity-slice-top: 30; -unity-slice-bottom: 40;
    -unity-slice-scale: 0.5px;
    border-width: 0;
    -unity-font-definition: var(--font-bold);
    font-size: 25px;
    color: var(--mhk-gray-900);
    letter-spacing: 0.5px;
    padding: 4px 28px 8px 28px;
    margin: 6px 4px;
    min-height: 58px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    -unity-text-align: middle-center;
    transition-property: scale, translate;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}
.mhk-button:hover, .mhk-button:focus {
    background-image: url("Textures/button_focus.png");
    color: var(--mhk-white);
    scale: 1.04 1.04;
    translate: 0 -1px;
}
.mhk-button:active { background-image: url("Textures/button_pressed.png"); color: var(--mhk-white); scale: 0.97 0.97; translate: 0 1px; }
.mhk-button.selected, .mhk-button.ctl-key.listening, .mhk-button.ctl-key.listening:hover, .mhk-button.ctl-key.listening:focus { background-image: url("Textures/button_accent.png"); color: var(--mhk-gray-900); }
.mhk-button.secondary { background-image: url("Textures/button_soft.png"); color: var(--mhk-gray-700); }
.mhk-button.go { background-image: url("Textures/button_dark.png"); color: var(--mhk-white); }
.mhk-button.secondary:hover, .mhk-button.secondary:focus, .mhk-button.go:hover, .mhk-button.go:focus { background-image: url("Textures/button_focus.png"); color: var(--mhk-white); }
.mhk-button.small { font-size: 20px; min-height: 44px; padding: 2px 18px 6px 18px; margin: 4px 3px; }
.mhk-button.big { font-size: 31px; min-height: 72px; padding: 6px 38px 10px 38px; }
.mhk-button:disabled { opacity: 0.45; }

.icon {
    width: 32px; height: 32px; flex-shrink: 0;
    background-size: contain;
    -unity-background-image-tint-color: var(--mhk-gray-700);
}
.mhk-button .icon { margin-right: 12px; margin-left: -6px; }
.mhk-button.small .icon { width: 24px; height: 24px; margin-right: 8px; }
.mhk-button.go .icon, .mhk-button:hover .icon, .mhk-button:focus .icon, .mhk-button:active .icon { -unity-background-image-tint-color: var(--mhk-white); }
.mhk-button.selected .icon { -unity-background-image-tint-color: var(--mhk-gray-900); }
.mhk-button.icon-only { padding: 4px 12px 8px 12px; min-width: 58px; }
.mhk-button.icon-only .icon { margin: 0; }

.header { height: 128px; flex-shrink: 0; align-items: center; justify-content: center; }
.page-title {
    -unity-font-definition: var(--font-display);
    font-size: 72px;
    color: var(--mhk-white);
    -unity-text-outline: 3px var(--mhk-outline);
    text-shadow: 0 5px 10px var(--mhk-shadow);
    -unity-text-align: middle-center;
    letter-spacing: 1px;
    white-space: nowrap;
}
.ribbon {
    height: 60px;
    min-width: 360px;
    padding: 0 44px 2px 44px;
    justify-content: center;
    border-radius: 14px;
    background-color: var(--mhk-gray-800);
    border-bottom-width: 3px; border-color: var(--mhk-gray-900);
}
.ribbon-label {
    -unity-font-definition: var(--font-display);
    font-size: 36px;
    color: var(--mhk-white);
    -unity-text-align: middle-center;
    letter-spacing: 1px;
}

.tabs {
    flex-direction: row; justify-content: center; flex-wrap: wrap; flex-shrink: 0;
    align-self: center;
    margin-bottom: 10px;
    padding: 4px;
    border-radius: 26px;
    background-color: var(--mhk-glass-lite-fill);
    border-width: 1px; border-color: var(--mhk-glass-rim); border-top-color: var(--mhk-glass-rim-top);
}
.panel .tabs { background-color: var(--mhk-row); border-color: transparent; }

.mhk-tooltip {
    position: absolute;
    max-width: 460px;
    padding: 8px 16px 10px 16px;
    border-radius: 12px;
    background-color: rgba(23, 25, 29, 0.94);
    border-width: 1px; border-color: var(--mhk-glass-dark-rim);
    -unity-font-definition: var(--font-body);
    font-size: 19px;
    color: var(--mhk-white);
    white-space: normal;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.12s;
}
.mhk-tooltip.shown { opacity: 1; }
.chip {
    background-color: transparent;
    background-image: none;
    border-width: 2px; border-color: transparent;
    border-radius: 20px;
    -unity-font-definition: var(--font-bold);
    font-size: 18px;
    color: var(--mhk-gray-600);
    padding: 0 16px 2px 16px;
    margin: 0 1px;
    min-height: 38px;
    transition-property: scale, background-color;
    transition-duration: 0.1s;
}
.chip:hover, .chip:focus { background-color: var(--mhk-gray-800); color: var(--mhk-white); scale: 1.05 1.05; }
.chip.selected, TemplateContainer.sample-selected > .chip { background-color: var(--mhk-accent); color: var(--mhk-gray-900); }
.chip.selected:hover, .chip.selected:focus { border-color: var(--mhk-gray-900); }
.mhk-button.selected:hover, .mhk-button.selected:focus { background-image: url("Textures/button_accent_focus.png"); color: var(--mhk-gray-900); }

/* Card frames (mui_card*.png) keep a 10 px transparent margin for the shadow and the focus glow: the visible card is
 * 20 px smaller than the element, the -3 px margins leave 14 px between visible cards. Content sits inside the 16 px
 * padding. Focused / hovered: accent ring + glow, lifted. Selected (the current choice): charcoal ring and the check badge. */
.card-grid { flex-direction: row; flex-wrap: wrap; justify-content: center; padding: 6px; }
.card {
    width: 206px; height: 246px;
    margin: -3px;
    background-image: url("Textures/mui_card.png");
    -unity-slice-left: 52; -unity-slice-right: 52; -unity-slice-top: 52; -unity-slice-bottom: 52;
    -unity-slice-scale: 0.5px;
    background-color: transparent;
    border-width: 0;
    align-items: center;
    justify-content: flex-end;
    padding: 16px;
    color: var(--mhk-gray-900);
    transition-property: scale, translate;
    transition-duration: 0.14s;
    transition-timing-function: ease-out;
}
.card:hover, .card:focus {
    background-image: url("Textures/mui_card_focus.png");
    scale: 1.05 1.05;
    translate: 0 -3px;
}
.card.selected, TemplateContainer.sample-selected > .card { background-image: url("Textures/mui_card_selected.png"); }
.card.selected:hover, .card.selected:focus { background-image: url("Textures/mui_card_focus.png"); }
.card-image {
    flex-grow: 1; width: 100%;
    border-radius: 8px;
    background-size: cover;
    background-color: var(--mhk-gray-100);
    margin-bottom: 6px;
}
.card-label {
    -unity-font-definition: var(--font-bold);
    font-size: 21px;
    color: var(--mhk-gray-900);
    -unity-text-align: middle-center;
    white-space: normal;
}
.card-tag { font-size: 14px; color: var(--mhk-gray-500); -unity-text-align: middle-center; white-space: normal; }
.card-badge {
    position: absolute; right: 2px; top: 2px;
    width: 40px; height: 40px;
    background-image: url("Textures/badge_gold.png");
    align-items: center; justify-content: center;
}
.card-badge .icon { width: 22px; height: 22px; -unity-background-image-tint-color: var(--mhk-gray-900); }
.card-check {
    display: none;
    position: absolute; left: 4px; top: 4px;
    width: 34px; height: 34px;
    background-image: url("Textures/badge_gold.png");
    align-items: center; justify-content: center;
}
.card-check .icon { width: 22px; height: 22px; -unity-background-image-tint-color: var(--mhk-gray-900); }
.card.selected > .card-check, TemplateContainer.sample-selected > .card > .card-check { display: flex; }

.stat-row { flex-direction: row; align-items: center; margin: 5px 0; }
.stat-label { width: 150px; font-size: 19px; color: var(--mhk-gray-600); }
.stat-bar-bg {
    width: 220px; height: 12px;
    background-color: var(--mhk-gray-100);
    border-radius: 6px;
    overflow: hidden;
}
.stat-bar {
    height: 100%;
    background-color: var(--mhk-gray-800);
    border-radius: 6px;
    transition-property: width;
    transition-duration: 0.35s;
    transition-timing-function: ease-out;
}

.setting-row { flex-direction: row; align-items: center; justify-content: space-between; margin: 2px 0; min-width: 560px; min-height: 52px; padding: 0 4px 0 12px; border-radius: 10px; }
.setting-row:hover { background-color: var(--mhk-row-hover); }
.setting-label { font-size: 22px; color: var(--mhk-gray-800); }
.setting-row .mhk-button { min-width: 190px; }

/* Dropdown list of a setting row (ChoiceList): a glass plate over the screen, placed by code below or above the button.
 * The focused item has the accent ring, the current value the check. */
.choice-overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.panel.choice-list {
    position: absolute;
    padding: 8px;
    border-radius: 14px;
    border-color: var(--mhk-gray-300);
    border-top-color: var(--mhk-glass-rim-top);
    border-bottom-width: 2px;
    opacity: 0;
    translate: 0 -6px;
    transition-property: opacity, translate;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}
.panel.choice-list.shown { opacity: 1; translate: 0 0; }
.choice-scroll { flex-shrink: 1; }
.choice-item {
    flex-direction: row;
    align-items: center;
    background-color: transparent;
    background-image: none;
    border-width: 2px; border-color: transparent;
    border-radius: 10px;
    margin: 1px 0;
    padding: 2px 10px 4px 16px;
    min-height: 44px;
    -unity-font-definition: var(--font-bold);
    font-size: 20px;
    color: var(--mhk-gray-800);
}
.choice-item-label { flex-grow: 1; -unity-text-align: middle-left; padding: 0; margin: 0; }
.choice-item .icon { width: 22px; height: 22px; margin-left: 14px; visibility: hidden; -unity-background-image-tint-color: var(--mhk-gray-900); }
.choice-item.selected { background-color: var(--mhk-accent-soft); }
.choice-item.selected .icon { visibility: visible; }
.choice-item:hover { background-color: var(--mhk-row-hover); }
.choice-item:focus { background-color: var(--mhk-gray-800); border-color: var(--mhk-accent); color: var(--mhk-white); }
.choice-item:focus .icon { -unity-background-image-tint-color: var(--mhk-accent); }

.unity-base-slider__label { -unity-font-definition: var(--font-body); font-size: 22px; color: var(--mhk-gray-800); min-width: 200px; }
.unity-base-slider__tracker { background-color: rgba(23, 25, 29, 0.2); border-width: 0; border-radius: 4px; height: 8px; margin-top: -4px; }
.unity-base-slider__dragger { background-color: var(--mhk-white); border-color: var(--mhk-gray-700); border-width: 3px; border-radius: 12px; width: 24px; height: 24px; margin-top: -12px; }
.unity-base-slider__dragger-border { display: none; }
.unity-base-slider:focus .unity-base-slider__dragger { background-color: var(--mhk-accent); border-color: var(--mhk-gray-900); scale: 1.15 1.15; }

.unity-scroller--vertical { width: 12px; }
.unity-scroller .unity-base-slider__tracker { background-color: var(--mhk-row-hover); border-width: 0; width: 8px; margin-left: 2px; border-radius: 4px; height: auto; margin-top: 0; }
.unity-scroller .unity-base-slider__dragger { background-color: var(--mhk-gray-500); border-width: 0; width: 8px; margin-left: 2px; border-radius: 4px; height: auto; margin-top: 0; }
.unity-scroller__low-button, .unity-scroller__high-button { display: none; }

.badge { width: 56px; height: 56px; background-image: url("Textures/badge_dark.png"); align-items: center; justify-content: center; }
/* TemplateContainer.sample-* = the same look on a UXML sample (<ui:Instance class="sample-gold">) for UI Builder. Code
 * clones templates without a TemplateContainer and sets .gold etc., so these selectors never match in game. */
.badge.gold, TemplateContainer.sample-gold .badge { background-image: url("Textures/badge_gold.png"); }
.badge.silver, TemplateContainer.sample-silver .badge { background-image: url("Textures/badge_silver.png"); }
.badge.bronze, TemplateContainer.sample-bronze .badge { background-image: url("Textures/badge_bronze.png"); }
.badge-label { -unity-font-definition: var(--font-display); font-size: 26px; color: var(--mhk-white); -unity-text-align: middle-center; }
.badge.gold .badge-label, .badge.silver .badge-label, .badge.bronze .badge-label,
TemplateContainer.sample-gold .badge-label, TemplateContainer.sample-silver .badge-label, TemplateContainer.sample-bronze .badge-label { color: var(--mhk-gray-900); }

.checker-strip { height: 12px; background-image: url("Textures/checker.png"); background-repeat: repeat-x; background-size: 1536px 12px; background-position-x: left 0; opacity: 0.9; }
.vignette { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-image: url("Textures/vignette.png"); background-size: 100% 100%; }
.sunburst { position: absolute; background-image: url("Textures/sunburst.png"); background-size: contain; }

.i-arrow_back { background-image: url("Icons/arrow_back.png"); }
.i-arrow_forward { background-image: url("Icons/arrow_forward.png"); }
.i-bolt { background-image: url("Icons/bolt.png"); }
.i-check { background-image: url("Icons/check.png"); }
.i-arrow_downward { background-image: url("Icons/arrow_downward.png"); }
.i-arrow_upward { background-image: url("Icons/arrow_upward.png"); }
.i-chevron_left { background-image: url("Icons/chevron_left.png"); }
.i-chevron_right { background-image: url("Icons/chevron_right.png"); }
.i-delete { background-image: url("Icons/delete.png"); }
.i-download { background-image: url("Icons/download.png"); }
.i-emoji_events { background-image: url("Icons/emoji_events.png"); }
.i-extension { background-image: url("Icons/extension.png"); }
.i-door_open { background-image: url("Icons/door_open.png"); }
.i-folder_open { background-image: url("Icons/folder_open.png"); }
.i-flag { background-image: url("Icons/flag.png"); }
.i-home { background-image: url("Icons/home.png"); }
.i-landscape { background-image: url("Icons/landscape.png"); }
.i-leaderboard { background-image: url("Icons/leaderboard.png"); }
.i-music_note { background-image: url("Icons/music_note.png"); }
.i-pause { background-image: url("Icons/pause.png"); }
.i-palette { background-image: url("Icons/palette.png"); }
.i-play_arrow { background-image: url("Icons/play_arrow.png"); }
.i-replay { background-image: url("Icons/replay.png"); }
.i-restart_alt { background-image: url("Icons/restart_alt.png"); }
.i-settings { background-image: url("Icons/settings.png"); }
.i-shuffle { background-image: url("Icons/shuffle.png"); }
.i-skip_next { background-image: url("Icons/skip_next.png"); }
.i-skip_previous { background-image: url("Icons/skip_previous.png"); }
.i-slow_motion_video { background-image: url("Icons/slow_motion_video.png"); }
.i-sports_motorsports { background-image: url("Icons/sports_motorsports.png"); }
.i-sports_score { background-image: url("Icons/sports_score.png"); }
.i-star { background-image: url("Icons/star.png"); }
.i-swords { background-image: url("Icons/swords.png"); }
.i-timer { background-image: url("Icons/timer.png"); }
.i-tune { background-image: url("Icons/tune.png"); }
.i-upload { background-image: url("Icons/upload.png"); }
.i-visibility { background-image: url("Icons/visibility.png"); }
.i-warning { background-image: url("Icons/warning.png"); }
.i-add { background-image: url("Icons/add.png"); }
.i-campaign { background-image: url("Icons/campaign.png"); }
.i-joystick { background-image: url("Icons/joystick.png"); }
.i-location_on { background-image: url("Icons/location_on.png"); }
.i-search_hands_free { background-image: url("Icons/search_hands_free.png"); }
.i-videocam { background-image: url("Icons/videocam.png"); }

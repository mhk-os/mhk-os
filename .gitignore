# Based on https://github.com/github/gitignore/blob/main/Unity.gitignore

# Unity-generated folders (rebuilt from Assets/, Packages/ and ProjectSettings/)
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
*.log

# Player builds and built mods (MHK ▸ Modding ▸ Build ... writes Builds/Mods/)
/[Bb]uild/
/[Bb]uilds/
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta
crashlytics-build.properties

# Local symlinks: private workspace (notes, archives, extracted originals) and the original games
/work
/originals

# IDE / solution files (Unity regenerates them)
.vs/
.idea/
.vscode/
.gradle/
.consulo/
ExportedObj/
/[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt
mono_crash.*

# Blender backups
*.blend1
*.blend1.meta

# Generated by tests / UI Toolkit / scene dependency cache
InitTestScene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
/UIElementsSchema/
/[Aa]ssets/[Ss]ceneDependencyCache*

# OS / tooling
.DS_Store
__pycache__/

# Performance Testing package build hook output
/Assets/Resources/PerformanceTestRun*.json*
